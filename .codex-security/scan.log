     1	"""Network-personality policy core — declare, default, gate, resolve.
     2	
     3	A *personality* is a named egress chain. This module is PURE policy/config: it parses
     4	operator-declared personalities, holds the per-engine default + per-job request, and resolves
     5	the effective personality FAIL-CLOSED. It applies no networking — a later plan reads the
     6	resolved Personality and wires the worker's network.
     7	"""
     8	from __future__ import annotations
     9	
    10	import sys
    11	from collections.abc import Mapping
    12	from dataclasses import dataclass, field
    13	
    14	# Exit drivers the design names. `none` (default) and `drop` need no sidecar; `direct`/`inetsim`
    15	# are ship-cheap; `tor` is CAPE's transparent recipe (TransPort + DNSPort, host rooter); `socks` is
    16	# the transparent SOCKS5-client tier (tun2socks); `httpproxy` injects an HTTP(S)_PROXY env pointing
    17	# at a creds-holding chaining sidecar (e.g. gost→BrightData); `wireguard`/`openvpn` are BYO creds.
    18	VALID_EXIT_DRIVERS = (
    19	    "none", "drop", "direct", "inetsim", "tor", "socks", "httpproxy", "wireguard", "openvpn",
    20	)
    21	
    22	
    23	@dataclass(frozen=True)
    24	class Personality:
    25	    """A named egress personality. ``config`` is opaque exit-specific data (socks endpoint,
    26	    wireguard conf ref, dns, …) consumed by a later plan — kept verbatim here.
    27	
    28	    Frozen: ``NONE`` is a module-level singleton returned directly from
    29	    ``resolve_net_policy``, so scalar fields must not be mutable per-process global state.
    30	    (``config`` stays a plain dict — frozen blocks the more likely scalar-field accidents.)"""
    31	
    32	    name: str
    33	    exit_driver: str
    34	    inspect: bool = False
    35	    config: dict[str, str] = field(default_factory=dict)
    36	
    37	
    38	# The always-present safe default: no egress. Resolution falls back here fail-closed.
    39	NONE = Personality(name="none", exit_driver="none")
    40	
    41	
    42	_NETPOLICY_PREFIX = "BLASTBOX_NETPOLICY_"
    43	
    44	
    45	def _parse_decl(name: str, raw: str) -> Personality | None:
    46	    """Parse one ``exit=...,k=v,...`` declaration into a Personality, or None (warn) if
    47	    malformed. Comma-separated KEY=VALUE (values can't contain a comma — fine here)."""
    48	    kv: dict[str, str] = {}
    49	    for item in raw.split(","):
    50	        item = item.strip()
    51	        if not item:
    52	            continue
    53	        if "=" not in item:
    54	            print(f"warning: ignoring malformed netpolicy {name!r} entry {item!r} "
    55	                  "(expected KEY=VALUE)", file=sys.stderr)
    56	            return None
    57	        k, _, v = item.partition("=")
    58	        kv[k.strip().lower()] = v.strip()
    59	
    60	    exit_driver = kv.pop("exit", "")
    61	    if exit_driver not in VALID_EXIT_DRIVERS:
    62	        print(f"warning: ignoring netpolicy {name!r}: exit={exit_driver!r} not one of "
    63	              f"{', '.join(VALID_EXIT_DRIVERS)}", file=sys.stderr)
    64	        return None
    65	    inspect = kv.pop("inspect", "").lower() in ("1", "true", "yes", "on")
    66	    return Personality(name=name, exit_driver=exit_driver, inspect=inspect, config=kv)
    67	
    68	
    69	def parse_personalities(env: Mapping[str, str]) -> dict[str, Personality]:
    70	    """Build the personality registry from ``BLASTBOX_NETPOLICY_<NAME>`` env vars. ``none`` is
    71	    always present (the fail-closed default). A declaration with an unknown exit-driver or
    72	    missing ``exit`` is warned-and-skipped, so it never becomes selectable."""
    73	    registry: dict[str, Personality] = {"none": NONE}
    74	    for env_key, raw in env.items():
    75	        if not env_key.startswith(_NETPOLICY_PREFIX):
    76	            continue
    77	        name = env_key[len(_NETPOLICY_PREFIX):].lower()
    78	        if not name:
    79	            continue
    80	        if name == "none":
    81	            # "none" is the reserved fail-closed default; an operator must not be able to
    82	            # redefine it (e.g. BLASTBOX_NETPOLICY_NONE=exit=direct), or resolve_net_policy's
    83	            # `registry["none"]` fallback would silently grant egress. Surface + ignore.
    84	            print("warning: BLASTBOX_NETPOLICY_NONE is reserved (the fail-closed default) and "
    85	                  "is ignored", file=sys.stderr)
    86	            continue
    87	        p = _parse_decl(name, raw or "")
    88	        if p is not None:
    89	            registry[name] = p
    90	    return registry
    91	
    92	
    93	def resolve_net_policy(
    94	    *,
    95	    job_net_policy: str | None,
    96	    engine_default: str,
    97	    registry: Mapping[str, Personality],
    98	    allow_override: bool,
    99	) -> Personality:
   100	    """Resolve the effective personality, FAIL-CLOSED to ``none``. Order: per-job override
   101	    (only when ``allow_override`` AND the name is declared) → per-engine default (when declared)
   102	    → ``none``. An unknown name at any step collapses to ``none`` rather than erroring."""
   103	    if allow_override and job_net_policy and job_net_policy in registry:
   104	        return registry[job_net_policy]
   105	    if engine_default in registry:
   106	        return registry[engine_default]
   107	    return registry.get("none", NONE)
