    33	
    34	@dataclass(frozen=True)
    35	class VmEgressPolicy:
    36	    """The filter half of a netpolicy personality, for a VM worker."""
    37	
    38	    exit_driver: str  # none | drop | direct | openvpn | wireguard | tor
