import subprocess
from blastbox.host.runtime.libvirt_egress import LibvirtEgress, VmEgressPolicy, ExitRouting
class FakeEgress(LibvirtEgress):
    def __init__(self):
        super().__init__(sudo=False, routing=ExitRouting())
        self.calls=[]
    def _priv(self, argv, check=False):
        self.calls.append((list(argv), check))
        # Simulate ip6tables missing/failing. Because the real call is unchecked, apply should still return.
        if argv and argv[0] == 'ip6tables':
            return subprocess.CompletedProcess(argv, 1, '', 'ip6tables failed')
        return subprocess.CompletedProcess(argv, 0, '', '')

def show(mac):
    fe=FakeEgress()
    fe.apply('192.0.2.10', VmEgressPolicy(exit_driver='direct'), gateway='192.0.2.1', mac=mac)
    print('mac=', mac, 'call_count=', len(fe.calls))
