   473	    @app.post("/v1/jobs", status_code=202)
   474	    async def submit_job(
   475	        file: UploadFile = File(...),
   476	        engine: str = Form(...),
   477	        params: list[str] = Form(default=[]),
   478	        target_tier: str | None = Form(default=None),
   479	        net_policy: str | None = Form(default=None),
   480	    ):
   481	        """Submit a file for detonation by the named engine.
   482	
   483	        Security:
   484	        - ``engine`` is validated against the configured allowlist (req. 7).
   485	        - ``_safe_upload_name`` sanitizes the filename (req. 2).
   486	        - Upload is spooled under ``_intake_gate`` (req. 5).
   487	        - Errors are scrubbed before returning (req. 6).
   488	        """
   489	        # Requirement 7: engine allowlist check before any disk I/O.
   490	        if _allowed_engines and engine not in _allowed_engines:
   491	            record_rejection("unknown_engine")
   492	            raise HTTPException(
   493	                400,
   494	                detail={
   495	                    "error": "unknown_engine",
   496	                    "detail": f"engine {engine!r} is not in the allowed set",
   497	                },
   498	            )
   499	
   500	        # Requirement 2: safe filename
   501	        safe_name = _safe_upload_name(file.filename)
   502	        if safe_name != (file.filename or ""):
   503	            _log.info(
   504	                "upload_filename_sanitized",
   505	                raw=file.filename,
   506	                safe=safe_name,
   507	            )
   508	
   509	        # Bound params at ingest: cap count + entry length so a hostile client can't bloat the
   510	        # persisted job (and amplify the full-list job listing). Reject (400) rather than
   511	        # silently truncate. (Before reaching worker env the dispatcher's _sanitize_params
   512	        # enforces the key SHAPE, DROPS reserved keys — BLASTBOX_*/LD_*/PYTHON*/engine
   513	        # breadcrumbs — and length-caps each value.)
   514	        if len(params) > _MAX_PARAMS:
   515	            raise HTTPException(400, f"too many params (max {_MAX_PARAMS})")
   516	        parsed_params: dict[str, str] = {}
   517	        for p in params:
   518	            if len(p) > _MAX_PARAM_LEN:
   519	                raise HTTPException(400, f"param too long (max {_MAX_PARAM_LEN} chars)")
   520	            if "=" in p:
   521	                k, _, v = p.partition("=")
   522	                parsed_params[k.strip()] = v.strip()
   523	            else:
   524	                parsed_params[p.strip()] = ""
   525	
   526	        job = Job.new(engine=engine, filename=safe_name)
   527	        job.params = parsed_params
   528	
   529	        # Optional per-job tier routing — an OPERATOR/TEST knob, default-OFF. Pinning a job to a
   530	        # specific tier is a scheduling control, so an untrusted client must not be able to flood
   531	        # or starve a pool (DoS) or force the break-glass cold tier: it's honored ONLY when the
   532	        # operator sets BLASTBOX_ALLOW_TIER_ROUTING. Off (default) → silently ignored, like a
   533	        # non-allowlisted param. On → validated against the tier vocabulary and routed at claim.
   534	        tt_raw = (target_tier or "").strip()  # missing / empty / whitespace-only all → ignored
   535	        if tt_raw:
   536	            if os.environ.get("BLASTBOX_ALLOW_TIER_ROUTING", "").strip().lower() in (
   537	                "1", "true", "yes", "on"
   538	            ):
   539	                tt = tt_raw.lower()
   540	                if tt not in VALID_TIERS:
   541	                    raise HTTPException(
   542	                        400, f"invalid target_tier (allowed: {', '.join(VALID_TIERS)})"
   543	                    )
   544	                job.target_tier = tt
   545	            else:
   546	                # Dropped (routing disabled); cap the attacker-controlled value in the log line.
   547	                _log.info("target_tier_ignored_routing_disabled", requested=tt_raw[:64])
   548	
   549	        # Per-job network personality: ignored unless the operator sets
   550	        # BLASTBOX_ALLOW_NETPOLICY_OVERRIDE. Off (default) → silently ignored, mirroring
   551	        # target_tier. The NAME is validated against the registry at dispatch (fail-closed),
   552	        # so ingress only needs the gate here.
   553	        np_raw = (net_policy or "").strip()
   554	        if np_raw:
   555	            if os.environ.get("BLASTBOX_ALLOW_NETPOLICY_OVERRIDE", "").strip().lower() not in (
   556	                "1", "true", "yes", "on",
   557	            ):
   558	                _log.info("net_policy_ignored_override_disabled", requested=np_raw[:64])
   559	            elif len(np_raw) > 64 or not re.fullmatch(r"[A-Za-z0-9_-]+", np_raw):
   560	                # A personality name is a short token (the BLASTBOX_NETPOLICY_<NAME> suffix). Bound
   561	                # length + charset before persisting — net_policy is stored on the job and echoed in
   562	                # list/status responses, so an unbounded form value must not be accepted (it would
   563	                # fail closed as an unknown name at dispatch anyway, but never get stored/echoed).
   564	                _log.info("net_policy_rejected_invalid_name", requested=np_raw[:64])
   565	            else:
   566	                job.net_policy = np_raw.lower()
   567	
   568	        root, input_dir, output_dir = _job_dirs(job.job_id)
   569	
   570	        try:
   571	            root.mkdir(parents=True, exist_ok=True)
   572	            input_dir.mkdir(parents=True, exist_ok=True)
   573	            output_dir.mkdir(parents=True, exist_ok=True)
