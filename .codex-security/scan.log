   375	        job = _job_store.get(job_id)
   376	        if job is None:
   377	            raise HTTPException(404, "job not found")
   378	        if job.status == JobStatus.EXPIRED:
   379	            raise HTTPException(410, "result expired")
   380	        if job.status != JobStatus.DONE:
   381	            raise HTTPException(409, f"job not done (status={job.status.value})")
   382	        return job
   383	
   384	    def _output_dir_for(job_id: str) -> Path:
   385	        """Re-derive the output directory from job_root and job_id.
   386	
   387	        FIX 3: Do NOT trust ``job.result_dir`` (a persisted store value is a
   388	        weaker trust boundary than the server-controlled ``job_root``).  Always
   389	        compute ``job_root / <uuid> / output`` so that a tampered or corrupted
   390	        ``result_dir`` cannot redirect artifact serving outside job_root.
   391	        """
   392	        return _job_root / job_id / "output"
   393	
   394	    def _public_detail(exc: Exception | str) -> str:
   395	        return sanitize_public_error(str(exc))
