   547	        if personality.exit_driver != "httpproxy":
   548	            return {}
   549	        proxy = (personality.config.get("proxy") or "").strip()
   550	        if not proxy:
   551	            return {}
   552	        parsed = urllib.parse.urlparse(proxy)
   553	        ok = (
   554	            parsed.scheme in ("http", "https", "socks5", "socks5h")
   555	            and bool(parsed.hostname)
   556	            and " " not in proxy and "\n" not in proxy
   557	        )
   558	        if not ok:
