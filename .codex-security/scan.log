    27	    try:
    28	        return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    29	    except subprocess.TimeoutExpired:
    30	        # a hung iptables/ip call must not abort apply/remove mid-rule with an uncaught exception
    31	        return subprocess.CompletedProcess(args, 124, "", "timeout")
