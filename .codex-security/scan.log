   141	            ["ip", "rule", "add", "from", worker_ip, "to", local, "lookup", "main", "priority", str(prio - 1)],
   142	            ["ip", "rule", "add", "from", worker_ip, "lookup", routing.vpn_table, "priority", str(prio)],
   143	            ["iptables", "-t", "nat", "-A", "POSTROUTING", "-s", worker_ip,
