   166	class SecurityHeadersMiddleware:
   167	    """Set hardening response headers on every response.
   168	
   169	    Restores the posture the engines' bespoke hosts enforced before the
   170	    blastbox.host migration (clickjacking, MIME-sniffing, referrer leakage, and a
   171	    baseline CSP) — a host that processes untrusted uploads and renders
   172	    attacker-influenced strings in its UI must not ship these open. CSP is
   173	    overridable via ``BLASTBOX_CSP`` (empty string disables the CSP header only;
   174	    the other three headers are unconditional).
   175	
   176	    Pure ASGI (not BaseHTTPMiddleware): it only injects headers into the
   177	    ``http.response.start`` message and never touches the body, so it is safe for
   178	    the host's many streaming ``FileResponse``s (pdf / pages / result zip) — which
   179	    BaseHTTPMiddleware would buffer.
   180	    """
   181	
   182	    def __init__(self, app, csp: str = DEFAULT_CSP) -> None:
   183	        self.app = app
   184	        self._headers: list[tuple[bytes, bytes]] = [
   185	            (b"x-frame-options", b"DENY"),
   186	            (b"x-content-type-options", b"nosniff"),
   187	            (b"referrer-policy", b"no-referrer"),
   188	        ]
   189	        if csp:
   190	            self._headers.append((b"content-security-policy", csp.encode("latin-1")))
   191	
   192	    async def __call__(self, scope, receive, send):
   193	        if scope["type"] != "http":
   194	            await self.app(scope, receive, send)
   195	            return
   196	
   197	        async def send_with_headers(message):
   198	            if message["type"] == "http.response.start":
   199	                headers = message.setdefault("headers", [])
   200	                present = {k.lower() for k, _ in headers}
   201	                for k, v in self._headers:
   202	                    if k not in present:  # don't clobber a header a route already set
   203	                        headers.append((k, v))
   204	            await send(message)
   205	
   206	        await self.app(scope, receive, send_with_headers)
