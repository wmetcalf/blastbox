from pathlib import Path
from tempfile import TemporaryDirectory
from urllib.request import build_opener, Request
from blastbox.engines.urlgrab import _CappedRedirect

with TemporaryDirectory() as td:
    secret = Path(td) / 'secret.txt'
    secret.write_text('redirect-secret-123', encoding='utf-8')
    newurl = secret.as_uri()
    h = _CappedRedirect()
    req = Request('http://example.test/start')
    redirected = h.redirect_request(req, None, 302, 'Found', {'Location': newurl}, newurl)
    opener = build_opener(_CappedRedirect())
    handlers = [type(x).__name__ for x in opener.handlers]
    body = opener.open(redirected, timeout=1).read().decode('utf-8')
    print({'redirected_url': redirected.full_url, 'has_file_handler': 'FileHandler' in handlers, 'has_data_handler': 'DataHandler' in handlers, 'body': body})
