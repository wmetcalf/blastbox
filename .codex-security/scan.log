from __future__ import annotations

import gc
import io
import os
from pathlib import Path
from tempfile import TemporaryDirectory

from fastapi import HTTPException
from starlette.datastructures import UploadFile

from blastbox.host.ingress.app import build_app
from blastbox.host.jobs.memory import InMemoryJobStore
from blastbox.limits import Limits
from blastbox.observability.metrics import JOBS_SUBMITTED_TOTAL


def metric_children(prefix: str) -> list[str]:
    children = getattr(JOBS_SUBMITTED_TOTAL, "_metrics", {})
    return sorted(label_values[0] for label_values in children if label_values[0].startswith(prefix))


def route_endpoint(app, path: str, method: str):
    for route in app.routes:
        if getattr(route, "path", None) == path and method in getattr(route, "methods", set()):
            return route.endpoint
    raise RuntimeError(f"route not found: {method} {path}")


async def submit(endpoint, *, engine: str, idx: int):
    upload = UploadFile(
        io.BytesIO(b"x"),
        filename=f"sample-{idx}.bin",
        size=1,
    )
    return await endpoint(
        file=upload,
        engine=engine,
        params=[],
        target_tier=None,
        net_policy=None,
    )


async def main_async() -> None:
    # Match documented defaults for the relevant controls.
    for name in (
        "BLASTBOX_ALLOWED_ENGINES",
        "BLASTBOX_REQUIRE_ENGINE_ALLOWLIST",
        "BLASTBOX_API_KEY",
        "BLASTBOX_METRICS_PUBLIC",
    ):
        os.environ.pop(name, None)

    prefix = "bbfd-s0016-proof-"
    engines = [f"{prefix}{idx:02d}" for idx in range(3)]
    blocked_engine = f"{prefix}blocked-by-allowlist"

    with TemporaryDirectory(prefix="bbfd-s0016-") as tmp:
        tmp_root = Path(tmp)
        store = InMemoryJobStore()
        app = build_app(
            job_store=store,
            job_root=tmp_root / "jobs",
            allowed_engines=set(),
            limits=Limits(max_input_bytes=1024),
            api_workers=1,
            api_key="",
            metrics_public=True,
            zip_password="",
        )
        submit_job = route_endpoint(app, "/v1/jobs", "POST")
        metrics_endpoint = route_endpoint(app, "/metrics", "GET")

        before_children = metric_children(prefix)
        before_metrics = metrics_endpoint().body
        print(f"open_allowlist_initial_child_count={len(before_children)}")
        print(f"open_allowlist_initial_metrics_bytes={len(before_metrics)}")

        for idx, engine in enumerate(engines):
            result = await submit(submit_job, engine=engine, idx=idx)
            print(f"submit engine={engine!r} status=accepted job_id={result['job_id']}")

        after_children = metric_children(prefix)
        after_metrics_response = metrics_endpoint()
        after_metrics = after_metrics_response.body
        after_metrics_text = after_metrics.decode("utf-8")
        matching_lines = [
            line
            for line in after_metrics_text.splitlines()
            if "blastbox_jobs_submitted" in line and prefix in line
        ]

        gc.collect()
        retained_after_gc_and_scrape = metric_children(prefix)

        print(f"open_allowlist_after_child_count={len(after_children)}")
        print(f"open_allowlist_after_children={after_children!r}")
        print(f"open_allowlist_after_metrics_status={after_metrics_response.status_code}")
        print(f"open_allowlist_after_metrics_bytes={len(after_metrics)}")
        print(f"open_allowlist_matching_metric_lines={len(matching_lines)}")
        print(f"open_allowlist_matching_metric_sample={matching_lines[:4]!r}")
        print(f"open_allowlist_retained_after_gc_and_scrape={len(retained_after_gc_and_scrape)}")

        strict_store = InMemoryJobStore()
        strict_app = build_app(
            job_store=strict_store,
            job_root=tmp_root / "strict-jobs",
            allowed_engines={"known-engine"},
            limits=Limits(max_input_bytes=1024),
            api_workers=1,
            api_key="",
            metrics_public=True,
            zip_password="",
        )
        strict_submit_job = route_endpoint(strict_app, "/v1/jobs", "POST")
        try:
            await submit(strict_submit_job, engine=blocked_engine, idx=99)
        except HTTPException as exc:
            strict_status = exc.status_code
        else:
            strict_status = "accepted"
        blocked_present = blocked_engine in metric_children(prefix)
        print(f"strict_allowlist_submit_status={strict_status}")
        print(f"strict_allowlist_blocked_engine_metric_present={blocked_present}")


if __name__ == "__main__":
    import asyncio

    asyncio.run(main_async())
