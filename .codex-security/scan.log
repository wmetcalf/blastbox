    40	    block_internal: bool = False
    41	
    42	    @classmethod
    43	    def from_personality(cls, p: Personality) -> "VmEgressPolicy":
    44	        cfg = p.config
    45	        block = cfg.get("block_internal", "").strip().lower() in ("1", "true", "yes", "on")
    46	        return cls(
    47	            exit_driver=p.exit_driver,
    48	            egress_ports=parse_egress_ports(cfg.get("egress_ports")),
    49	            block_internal=block,
    50	        )
