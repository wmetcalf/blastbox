   152	             "-p", "udp", "--dport", "53", "-j", "REDIRECT", "--to-ports", str(routing.tor_dns_port)],
   153	            ["iptables", "-t", "nat", "-A", "PREROUTING", "-s", worker_ip,
   154	             "-p", "tcp", "--dport", "53", "-j", "REDIRECT", "--to-ports", str(routing.tor_dns_port)],
