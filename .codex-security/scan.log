    12	class BodySizeLimitMiddleware:
    13	    """Reject HTTP requests whose body exceeds *max_bytes*.
    14	
    15	    Security guarantee:
    16	    - If ``Content-Length`` is present and exceeds the limit, 413 is returned
    17	      *before* reading any of the body (O(1) check).
    18	    - For chunked / no-Content-Length uploads the body is consumed via a
    19	      streaming wrapper that raises as soon as the running total exceeds the
    20	      limit — the body never fully reaches application code or disk.
    21	
    22	    Both paths call ``record_rejection("body_too_large")`` so the metric is
    23	    accurate regardless of how the upload is framed.
    24	
    25	    For chunked uploads, Starlette's multipart parser may catch the
    26	    ``RuntimeError`` from ``wrapped_receive`` and convert it to a 400 before
    27	    the middleware's outer ``except`` can see it.  To handle this, the
    28	    middleware tracks the over-limit condition in ``scope["state"]`` and
    29	    wraps ``send`` to intercept any 4xx that the inner app emits after the
    30	    flag is set, replacing it with a definitive 413.
    31	    """
    32	
    33	    def __init__(self, app, max_bytes: int) -> None:
    34	        self.app = app
    35	        self._max = max_bytes
    36	
    37	    async def __call__(self, scope, receive, send):
    38	        if scope["type"] != "http":
    39	            return await self.app(scope, receive, send)
    40	
    41	        # Fast path: Content-Length header present
    42	        headers = dict(scope.get("headers", []))
    43	        cl = headers.get(b"content-length")
    44	        if cl is not None:
    45	            try:
    46	                if int(cl) > self._max:
    47	                    record_rejection("body_too_large")
    48	                    response = PlainTextResponse(
    49	                        f"request body exceeds {self._max} bytes", status_code=413
    50	                    )
    51	                    await response(scope, receive, send)
    52	                    return
    53	            except ValueError:
    54	                response = PlainTextResponse("invalid content-length", status_code=400)
    55	                await response(scope, receive, send)
    56	                return
    57	
    58	        # Streaming path: count bytes as they arrive.
    59	        # Use scope["state"] to share over-limit condition with wrapped_send.
    60	        if "state" not in scope:
    61	            scope["state"] = {}
    62	        scope["state"]["body_too_large"] = False
    63	
    64	        body_size = 0
    65	        headers_sent = False
    66	
    67	        async def wrapped_receive():
    68	            nonlocal body_size
    69	            msg = await receive()
    70	            if msg["type"] == "http.request":
    71	                body_size += len(msg.get("body", b""))
    72	                if body_size > self._max:
    73	                    scope["state"]["body_too_large"] = True
    74	                    raise RuntimeError("request_body_too_large")
    75	            return msg
    76	
    77	        async def wrapped_send(msg):
    78	            nonlocal headers_sent
    79	            # If the body was too large, intercept any response the inner app
    80	            # tries to send (the multipart parser may have swallowed the
    81	            # RuntimeError and converted it to 400) and replace it with 413.
    82	            if scope["state"]["body_too_large"]:
