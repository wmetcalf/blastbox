from __future__ import annotations

import gc

from prometheus_client import generate_latest

from blastbox.observability.metrics import JOBS_SUBMITTED_TOTAL, record_job_submitted


def metric_children(prefix: str) -> list[str]:
    children = getattr(JOBS_SUBMITTED_TOTAL, "_metrics", {})
    return sorted(label_values[0] for label_values in children if label_values[0].startswith(prefix))


def main() -> None:
    prefix = "bbfd-s0016-sink-"
    engines = [f"{prefix}{idx:02d}" for idx in range(3)]
    engines.append(prefix + ("L" * 64))

    before_children = metric_children(prefix)
    before_metrics = generate_latest()
    print(f"initial_child_count={len(before_children)}")
    print(f"initial_metrics_bytes={len(before_metrics)}")

    for engine in engines:
        record_job_submitted(engine, 1)
        print(f"recorded_engine={engine!r}")

    after_children = metric_children(prefix)
    after_metrics = generate_latest()
    matching_lines = [
        line
        for line in after_metrics.decode("utf-8").splitlines()
        if "blastbox_jobs_submitted" in line and prefix in line
    ]

    gc.collect()
    retained_children = metric_children(prefix)
    retained_metrics = generate_latest()

    print(f"after_child_count={len(after_children)}")
    print(f"after_children={after_children!r}")
    print(f"after_metrics_bytes={len(after_metrics)}")
    print(f"matching_metric_lines={len(matching_lines)}")
    print(f"matching_metric_sample={matching_lines[:6]!r}")
    print(f"retained_after_gc_child_count={len(retained_children)}")
    print(f"retained_after_gc_metrics_bytes={len(retained_metrics)}")


if __name__ == "__main__":
    main()

