   113	class BearerAuthMiddleware(BaseHTTPMiddleware):
   114	    """Optional bearer-token authentication gate.
   115	
   116	    Installed only when ``BLASTBOX_API_KEY`` is set.  Compares tokens
   117	    via ``hmac.compare_digest`` to prevent timing-oracle attacks.
   118	
   119	    ``/v1/healthz`` and ``/v1/version`` are always public (proxy health checks
   120	    must not require auth).  ``GET /metrics`` is public by *default* so a Prometheus
   121	    scraper on the same host can reach it without a token; set ``metrics_public=False``
   122	    (``BLASTBOX_METRICS_PUBLIC=false``) to require the bearer token for ``/metrics`` too,
   123	    for deployments whose scraper can present the token.
   124	    """
   125	
   126	    _ALWAYS_PUBLIC: frozenset[str] = frozenset({"/v1/healthz", "/v1/version"})
   127	
   128	    def __init__(self, app, api_key: str, *, metrics_public: bool = True) -> None:
   129	        super().__init__(app)
   130	        self._key = api_key
   131	        self._public = (
   132	            self._ALWAYS_PUBLIC | {"/metrics"} if metrics_public else self._ALWAYS_PUBLIC
   133	        )
   134	
   135	    async def dispatch(self, request, call_next):
   136	        if request.url.path in self._public:
   137	            return await call_next(request)
   138	        header = request.headers.get("authorization", "")
   139	        if not header.startswith("Bearer "):
   140	            return PlainTextResponse("missing bearer token", status_code=401)
   141	        provided = header.removeprefix("Bearer ").strip()
   142	        if not hmac.compare_digest(provided, self._key):
   143	            return PlainTextResponse("invalid bearer token", status_code=401)
   144	        return await call_next(request)
   145	
