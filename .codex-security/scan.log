   147	# Default Content-Security-Policy: blocks external resource loads + framing, but
   148	# tolerates inline <script>/<style> because the engine UIs use them (clippyshot's
   149	# index.html inlines its JS; both inline style attrs). Engines that don't need
   150	# inline (e.g. redtusk's external app.js) can tighten via BLASTBOX_CSP. The app
   151	# still escapes all untrusted text (filenames / extracted text / QR payloads) at
   152	# render time, so 'unsafe-inline' is defense-in-depth-weakened, not the only guard.
   153	DEFAULT_CSP = (
   154	    "default-src 'self'; "
   155	    "script-src 'self' 'unsafe-inline'; "
   156	    "style-src 'self' 'unsafe-inline'; "
   157	    "img-src 'self' data:; "
   158	    "font-src 'self'; "
   159	    "connect-src 'self'; "
   160	    "object-src 'none'; "
   161	    "base-uri 'none'; "
   162	    "frame-ancestors 'none'"
   163	)
