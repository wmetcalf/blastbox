   397	    def _serve_artifact_file(
   398	        job_id: str,
   399	        relative: str,
   400	        *,
   401	        media_type: str | None = None,
   402	        filename: str | None = None,
   403	    ):
   404	        """Serve a FIXED relative artifact path from a job's output dir.
   405	
   406	        Exposed on ``app.state`` so product ingress extensions (e.g. ClippyShot's
   407	        ``/pdf`` + typed page-PNG routes) reuse the core's confinement: DONE-gated,
   408	        ``resolve()+relative_to()`` containment, and no-symlink-follow.
   409	
   410	        TRUST-GATE ENFORCEMENT: unlike ``get_artifact`` (which resolves the served
   411	        path *from* the sealed manifest by id), this route is keyed by a fixed
   412	        relative path — so it MUST additionally require that ``relative`` is a
   413	        **declared** artifact in the dispatcher-sealed ``metadata.json``. Without
   414	        this, a compromised worker that declares a benign/empty manifest yet also
   415	        drops an undeclared ``document.pdf`` / ``page-NNN.png`` would have those
   416	        un-re-hashed bytes served as "trustworthy output" (the zero-trust re-seal
   417	        bypass). The host re-hashes only DECLARED artifacts, so anything not in the
   418	        manifest was never validated and must 404.
   419	        """
   420	        from fastapi.responses import FileResponse
   421	
   422	        _validate_job_id(job_id)
   423	        _require_done(job_id)
   424	        out = _output_dir_for(job_id)
   425	        if not out.is_dir():
   426	            raise HTTPException(410, "result expired")
   427	        if relative not in _declared_artifact_paths(out):
   428	            # Not a sealed/declared artifact → never re-validated by the trust gate.
   429	            raise HTTPException(404, "artifact file not found")
   430	        if (out / relative).is_symlink():
   431	            raise HTTPException(404, "artifact file not found")
   432	        safe = _safe_artifact_path(out, relative)
   433	        if safe is None or safe.is_symlink() or not safe.is_file():
   434	            raise HTTPException(404, "artifact file not found")
   435	        return FileResponse(safe, media_type=media_type, filename=filename)
