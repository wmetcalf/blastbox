    52	
    53	def _chain_name(worker_ip: str) -> str:
    54	    # iptables chain names: ≤28 chars, no dots. BBVM_<ip-with-underscores> fits IPv4.
    55	    return "BBVM_" + worker_ip.replace(".", "_")
    56	
    57	
    58	@dataclass(frozen=True)
    59	class ExitRouting:
    60	    """Host-side endpoints for rooter-style exit routing (single-NIC, route-tables + iptables).
    61	
    62	    The worker stays on its management network (so the host reaches its agent on the local
    63	    subnet); only its *external* egress is steered per exit driver. Defaults match toolz3's
    64	    CAPE infra (PIA tun0 + ``vpn`` table, FakeNet on br-fakenet)."""
    65	
    66	    vpn_table: str = "vpn"          # rt_tables entry whose default route is the VPN tun
    67	    vpn_tun: str = "tun0"           # device to MASQUERADE the worker's source onto
    68	    tor_trans_port: int = 9040      # tor TransPort (transparent TCP)
    69	    tor_dns_port: int = 9053        # tor DNSPort (NOT 5353 — that collides with mDNS/avahi)
    70	    fakenet_addr: str | None = None  # FakeNet-NG listen IP (e.g. 172.28.100.1); None disables inetsim
    71	    rule_priority_base: int = 1000  # ip-rule priority = base + low-16-bits of IP (unique per /16)
    72	
    73	    # --- shared-router / next-hop mode -------------------------------------------------
    74	    # When ``gateway`` + ``leg`` are set, openvpn/wireguard route the worker to a next-hop ROUTER VM
    75	    # on the ``leg`` network (which holds the VPN), instead of a local tun. Different gateways = the
    76	    # different provider routers (vpn1, vpn2, …); many blastbox hosts pointing at the same router
    77	    # share one VPN link. The default route ``via <gateway> dev <leg>`` lives in a per-gateway table
    78	    # (shared across this host's workers); per-worker ``ip rule``s select it.
    79	    gateway: str | None = None       # next-hop router IP on the leg network (None = local-tun mode)
    80	    leg: str | None = None           # host interface into the router network
    81	    gateway_table_base: int = 200    # per-gateway table = base + last octet of the gateway IP
    82	    gateway_masquerade: bool = True  # SNAT the worker onto the leg so the router replies to the host
    83	
    84	
    85	_ROUTING_DRIVERS = ("openvpn", "wireguard", "tor", "inetsim")  # drivers that install routing rules
    86	_SUPPORTED_EXITS = frozenset({"none", "drop", "direct", *_ROUTING_DRIVERS})  # exits the VM rooter wires
    87	
    88	
    89	def _rule_priority(worker_ip: str, routing: ExitRouting) -> int:
    90	    # Use the low 16 bits of the IP (third+fourth octets), not just the last octet, so two workers
    91	    # in *different* /24s of the same supernet (or a /16 libvirt net) never share a priority slot.
    92	    o = worker_ip.split(".")
    93	    return routing.rule_priority_base + (int(o[2]) << 8) + int(o[3])
    94	
    95	
    96	def _tor_tcp_redirects(worker_ip: str, routing: ExitRouting,
    97	                       egress_ports: tuple[int, ...] | None) -> list[list[str]]:
    98	    """TCP REDIRECT(s) into tor's TransPort. With an egress_ports allow-list set, only those TCP
    99	    ports (minus 53, handled by the DNS redirect) are sent to tor — so the allow-list composes with
   100	    tor (the rest fall through to the FORWARD drop). Unset = catch-all (all TCP), since tor applies
   101	    its own exit policy. (Non-TCP is always dropped in FORWARD regardless.)"""
   102	    tcp_ports = [p for p in (egress_ports or ()) if p != 53]
   103	    base = ["iptables", "-t", "nat", "-A", "PREROUTING", "-s", worker_ip, "-p", "tcp"]
   104	    tail = ["-j", "REDIRECT", "--to-ports", str(routing.tor_trans_port)]
   105	    if egress_ports is not None:
   106	        return [base + ["--dport", str(p)] + tail for p in tcp_ports]
   107	    return [base + tail]
   108	
   109	
   110	def routing_commands(worker_ip: str, exit_driver: str, routing: ExitRouting,
   111	                     egress_ports: tuple[int, ...] | None = None) -> list[list[str]]:
   112	    """The privileged argv (``ip``/``iptables`` nat) that *steer* the worker's external egress for
   113	    its exit driver — the rooter half, separate from the FORWARD *filter*. ``direct``/``none``/
   114	    ``drop`` need none (direct = main-table default; none/drop are filter-dropped). Each command is
   115	    idempotently torn down by :meth:`LibvirtEgress.remove` (delete-by-match, no priority guessing).
   116	
   117	    ``egress_ports`` (the policy's destination-port allow-list) port-scopes a tor exit's TCP REDIRECT
   118	    so the allow-list composes with tor; unset means all TCP via tor."""
   119	    if exit_driver in ("direct", "none", "drop"):
   120	        return []
   121	    local = ".".join(worker_ip.split(".")[:3]) + ".0/24"  # keep host/agent traffic on the local subnet
   122	    if exit_driver in ("openvpn", "wireguard"):
   123	        prio = _rule_priority(worker_ip, routing)
   124	        if routing.gateway and routing.leg:
   125	            # SHARED-ROUTER / next-hop mode: forward the worker to a router VM on the leg network
   126	            # that holds the VPN. The per-gateway table's default is via that router; many
   127	            # workers/hosts reusing the same router share one VPN link.
   128	            table = str(routing.gateway_table_base + int(routing.gateway.split(".")[-1]))
   129	            cmds = [
   130	                ["ip", "route", "replace", "default", "via", routing.gateway, "dev", routing.leg, "table", table],
   131	                ["ip", "rule", "add", "from", worker_ip, "to", local, "lookup", "main", "priority", str(prio - 1)],
   132	                ["ip", "rule", "add", "from", worker_ip, "lookup", table, "priority", str(prio)],
   133	            ]
   134	            if routing.gateway_masquerade:
   135	                cmds.append(["iptables", "-t", "nat", "-A", "POSTROUTING", "-s", worker_ip,
   136	                             "-o", routing.leg, "-j", "MASQUERADE"])
   137	            return cmds
   138	        # LOCAL-TUN mode: this host runs the VPN itself
   139	        return [
   140	            # local subnet (host + agent) stays on the main table; everything else → the VPN table
   141	            ["ip", "rule", "add", "from", worker_ip, "to", local, "lookup", "main", "priority", str(prio - 1)],
   142	            ["ip", "rule", "add", "from", worker_ip, "lookup", routing.vpn_table, "priority", str(prio)],
   143	            ["iptables", "-t", "nat", "-A", "POSTROUTING", "-s", worker_ip,
   144	             "-o", routing.vpn_tun, "-j", "MASQUERADE"],
   145	        ]
   146	    if exit_driver == "tor":
   147	        return [
   148	            # DNS FIRST (udp+tcp 53), BEFORE the local-subnet RETURN — otherwise DNS to the bridge
   149	            # resolver (192.168.122.1:53) matches the RETURN and resolves OUTSIDE tor (a deanon leak).
   150	            # Redirect it to tor's DNSPort so name resolution goes through tor too.
   151	            ["iptables", "-t", "nat", "-A", "PREROUTING", "-s", worker_ip,
   152	             "-p", "udp", "--dport", "53", "-j", "REDIRECT", "--to-ports", str(routing.tor_dns_port)],
   153	            ["iptables", "-t", "nat", "-A", "PREROUTING", "-s", worker_ip,
   154	             "-p", "tcp", "--dport", "53", "-j", "REDIRECT", "--to-ports", str(routing.tor_dns_port)],
   155	            ["iptables", "-t", "nat", "-A", "PREROUTING", "-s", worker_ip, "-d", local, "-j", "RETURN"],
   156	            # TCP → tor's TransPort: all of it (tor is a SOCKS proxy), OR only the allowlisted ports
   157	            # when egress_ports composes a port restriction onto tor. Non-allowlisted TCP + all
   158	            # non-TCP fall through to the FORWARD drop.
   159	        ] + _tor_tcp_redirects(worker_ip, routing, egress_ports)
   160	    if exit_driver == "inetsim":
   161	        if not routing.fakenet_addr:
   162	            return []
   163	        fn = routing.fakenet_addr
   164	        # DNS FIRST (even to the local bridge resolver) → FakeNet, so attacker C2 domains resolve to
   165	        # the sinkhole instead of NXDOMAIN'ing at dnsmasq. Then keep other host/agent control traffic
   166	        # local, and DNAT everything else (preserving dport) to the FakeNet-NG listener.
   167	        return [
   168	            ["iptables", "-t", "nat", "-A", "PREROUTING", "-s", worker_ip,
   169	             "-p", "udp", "--dport", "53", "-j", "DNAT", "--to-destination", fn + ":53"],
   170	            ["iptables", "-t", "nat", "-A", "PREROUTING", "-s", worker_ip,
   171	             "-p", "tcp", "--dport", "53", "-j", "DNAT", "--to-destination", fn + ":53"],
   172	            ["iptables", "-t", "nat", "-A", "PREROUTING", "-s", worker_ip, "-d", local, "-j", "RETURN"],
   173	            ["iptables", "-t", "nat", "-A", "PREROUTING", "-s", worker_ip,
   174	             "-j", "DNAT", "--to-destination", fn],
   175	        ]
   176	    return []
   177	
   178	
   179	def routing_teardown_commands(worker_ip: str, exit_driver: str, routing: ExitRouting,
   180	                              egress_ports: tuple[int, ...] | None = None) -> list[list[str]]:
   181	    """Inverse of :func:`routing_commands` — ``ip rule del`` + ``iptables -t nat -D`` by exact match.
   182	    ``egress_ports`` must match what was applied so a port-scoped tor's per-port REDIRECTs are torn
   183	    down (deployments are homogeneous, so the worker's own policy ports are the right set)."""
   184	    cmds: list[list[str]] = []
   185	    for c in routing_commands(worker_ip, exit_driver, routing, egress_ports):
   186	        if c[:2] == ["ip", "route"]:
   187	            continue  # the shared per-gateway default route is reusable infra — leave it in place
   188	        if c[:2] == ["ip", "rule"]:
   189	            cmds.append(["ip", "rule", "del"] + c[3:])  # del <selector...> (drop the "add")
   190	        else:  # iptables -t nat -A ... -> -D ...
   191	            cmds.append([("-D" if tok == "-A" else tok) for tok in c])
   192	    return cmds
   193	
   194	
   195	def forward_chain_rules(worker_ip: str, policy: VmEgressPolicy, gateway: str | None,
   196	                        egress_if: str | None = None) -> list[list[str]]:
   197	    """The ordered ``iptables`` rule bodies (sans ``iptables``) for the worker's dedicated FORWARD
   198	    chain. Order: return-traffic → gateway DNS → block-internal → exit disposition → web allowlist.
   199	
   200	    ``gateway`` (the libvirt bridge IP, dnsmasq) is exempted for DNS *before* the internal block so a
   201	    NAT/direct worker can still resolve revocation responders even with ``block_internal``."""
   202	    c = _chain_name(worker_ip)
   203	    r: list[list[str]] = [
   204	        ["-A", c, "-m", "conntrack", "--ctstate", "ESTABLISHED,RELATED", "-j", "ACCEPT"],
   205	    ]
   206	    if gateway and policy.exit_driver not in ("none", "drop", "tor"):
   207	        # DNS to the bridge resolver only (not arbitrary internal hosts). Skipped for none/drop —
   208	        # a no-egress policy must not leak even DNS — and for tor, whose DNS is fully REDIRECTed to
   209	        # the DNSPort in PREROUTING (so no FORWARD exemption is needed or wanted).
   210	        r.append(["-A", c, "-d", gateway, "-p", "udp", "--dport", "53", "-j", "ACCEPT"])
   211	        r.append(["-A", c, "-d", gateway, "-p", "tcp", "--dport", "53", "-j", "ACCEPT"])
   212	    if policy.block_internal:
   213	        r += [["-A", c, "-d", net, "-j", "DROP"] for net in _INTERNAL_NETS]
   214	
   215	    if policy.exit_driver in ("none", "drop"):
   216	        r.append(["-A", c, "-j", "DROP"])
   217	        return r
   218	
   219	    if policy.exit_driver == "tor":
   220	        # tor is a SOCKS/transparent TCP proxy. ALL TCP and DNS(53) were REDIRECTed into tor in
   221	        # PREROUTING, so they never traverse FORWARD; anything reaching here is a NON-TCP protocol
   222	        # (UDP≠53, ICMP, QUIC over UDP, …) that tor's TCP-only transport can't carry. DROP it so it
   223	        # can't leak straight to clearnet around tor. egress_ports does NOT port-restrict tor —
   224	        # tor applies its own exit policy. (ESTABLISHED return traffic was ACCEPTed above.)
   225	        r.append(["-A", c, "-m", "limit", "--limit", "10/min", "-j", "LOG",
   226	                  "--log-prefix", "bbvm-tor-nontcp-drop ", "--log-level", "4"])
   227	        r.append(["-A", c, "-j", "DROP"])
   228	        return r
   229	
   230	    # direct / openvpn / wireguard. ``egress_if`` (set for tunneled exits) is the KILL-SWITCH: scope
   231	    # the egress ACCEPTs to the tunnel/leg interface so that if the tunnel drops — and the worker's
   232	    # packets fall back to the host's default route — they hit the catch-all DROP instead of leaking
   233	    # out the host's WAN with the worker's traffic. ``direct`` has no egress_if (egress via host is
   234	    # the intent), so it ACCEPTs unscoped.
   235	    oif = ["-o", egress_if] if egress_if else []
   236	    if policy.egress_ports is not None:
   237	        if 53 in policy.egress_ports:
   238	            r.append(["-A", c, "-p", "udp", "--dport", "53", *oif, "-j", "ACCEPT"])
   239	        for i in range(0, len(policy.egress_ports), 15):  # multiport caps at 15 dports/rule
   240	            chunk = ",".join(str(p) for p in policy.egress_ports[i:i + 15])
   241	            r.append(["-A", c, "-p", "tcp", "-m", "multiport", "--dports", chunk, *oif, "-j", "ACCEPT"])
   242	        r.append(["-A", c, "-m", "limit", "--limit", "10/min", "-j", "LOG",
   243	                  "--log-prefix", "bbvm-egress-drop ", "--log-level", "4"])
   244	        r.append(["-A", c, "-j", "DROP"])
   245	    elif oif:
   246	        # tunneled exit, no port allowlist: permit ALL traffic, but ONLY out the tunnel. The trailing
   247	        # DROP is the kill-switch — tunnel down → no egress (fail closed), not a host-IP leak.
   248	        r.append(["-A", c, *oif, "-j", "ACCEPT"])
   249	        r.append(["-A", c, "-m", "limit", "--limit", "10/min", "-j", "LOG",
   250	                  "--log-prefix", "bbvm-killswitch-drop ", "--log-level", "4"])
   251	        r.append(["-A", c, "-j", "DROP"])
   252	    else:
   253	        # direct: no port allowlist, no tunnel → permit (egress via the host is the intent)
   254	        r.append(["-A", c, "-j", "ACCEPT"])
   255	    return r
   256	
   257	
   258	class LibvirtEgress:
   259	    """Installs / removes a VM worker's per-IP FORWARD egress chain via host iptables.
   260	
   261	    A dedicated chain + a single ``FORWARD -s <ip> -j BBVM_<ip>`` jump (inserted at the top so it
   262	    wins for this worker) keeps a co-resident rooter / sibling workers untouched, and ``remove()``
   263	    fully unhooks + flushes + deletes — no orphan rules.
   264	    """
   265	
   266	    def __init__(self, *, sudo: bool = True, routing: ExitRouting | None = None) -> None:
   267	        self._pfx = ["sudo"] if sudo else []
   268	        self._routing = routing
   269	
   270	    def _priv(self, argv: list[str], check: bool = False) -> subprocess.CompletedProcess:
   271	        cp = _run(self._pfx + argv)
   272	        if check and cp.returncode != 0:
   273	            raise RuntimeError(f"{' '.join(argv)} failed: {cp.stderr.strip()}")
   274	        return cp
   275	
   276	    def _ipt_run(self, *args: str, check: bool = False) -> subprocess.CompletedProcess:
   277	        return self._priv(["iptables", *args], check=check)
   278	
   279	    def apply(self, worker_ip: str, policy: VmEgressPolicy, gateway: str | None,
   280	              mac: str | None = None) -> None:
   281	        """Install the worker's egress (filter chain + jump + routing + v6 fail-closed).
   282	
   283	        Atomic / fail-closed: any failed rule rolls back the whole install via ``remove`` and
   284	        re-raises, so a worker is never left with a half-built (permissive) chain.
   285	        """
   286	        # Fail closed: a routed exit (vpn/tor/inetsim) needs ExitRouting to actually pin the worker's
   287	        # egress through the tunnel/redirect. Without it the FORWARD filter alone would let traffic
   288	        # take the host's default route (its real IP) — a silent deanonymization leak. Refuse rather
   289	        # than install a filter-only policy that looks restrictive but isn't.
   290	        if policy.exit_driver in _ROUTING_DRIVERS and self._routing is None:
   291	            raise ValueError(
   292	                f"exit_driver {policy.exit_driver!r} requires ExitRouting; refusing a leaky "
   293	                "filter-only policy (traffic would egress via the host default route)")
   294	        if policy.exit_driver == "inetsim" and not (self._routing and self._routing.fakenet_addr):
   295	            raise ValueError(
   296	                "exit_driver 'inetsim' requires ExitRouting.fakenet_addr (the FakeNet sink) — "
   297	                "without it nothing is DNATed and traffic egresses via the host default route")
   298	        if policy.exit_driver not in _SUPPORTED_EXITS:
   299	            # socks / httpproxy / anything else have no VM routing path here; the filter chain would
   300	            # otherwise ACCEPT and the worker would get direct host-network egress. Fail closed.
   301	            raise ValueError(
   302	                f"exit_driver {policy.exit_driver!r} is not supported by the VM rooter "
   303	                "(no routing path) — refusing to apply a permissive filter")
   304	        chain = _chain_name(worker_ip)
   305	        # clear any prior incarnation; pass this policy's ports so a prior port-scoped tor's per-port
   306	        # REDIRECTs are swept (deployments are homogeneous).
   307	        self.remove(worker_ip, mac=mac, egress_ports=policy.egress_ports)
   308	        try:
   309	            self._ipt_run("-N", chain, check=True)
   310	            # Kill-switch interface for a tunneled exit: the local tun for an on-host VPN, or the leg
   311	            # for next-hop/shared-router mode (the worker's traffic must leave via the router's leg).
   312	            egress_if = None
   313	            if policy.exit_driver in ("openvpn", "wireguard") and self._routing is not None:
   314	                egress_if = (self._routing.leg
   315	                             if (self._routing.gateway and self._routing.leg)
   316	                             else self._routing.vpn_tun)
   317	            for body in forward_chain_rules(worker_ip, policy, gateway, egress_if):
   318	                self._ipt_run(*body, check=True)
   319	            # hook at the TOP of FORWARD so the worker's policy is evaluated before generic rules
   320	            self._ipt_run("-I", "FORWARD", "1", "-s", worker_ip, "-j", chain, check=True)
   321	            # ANTI-SPOOF (inserted above the jump): a sample with guest admin/root could re-IP the VM
   322	            # to dodge the per-IP jump + policy routes above. Drop any forwarded packet from this
   323	            # worker's MAC whose source is NOT its assigned IP, so it can't egress around the policy.
   324	            if mac:
   325	                self._ipt_run("-I", "FORWARD", "1", "-m", "mac", "--mac-source", mac,
   326	                              "!", "-s", worker_ip, "-j", "DROP", check=True)
   327	            # rooter-style exit routing (policy-route / REDIRECT / DNAT), single-NIC
   328	            if self._routing is not None:
   329	                for cmd in routing_commands(worker_ip, policy.exit_driver, self._routing,
   330	                                            policy.egress_ports):
   331	                    self._priv(cmd, check=True)
   332	            # IPv6 fail-closed: the filter/routing above is IPv4-only, so drop ALL forwarded v6 from
   333	            # the worker (matched on its MAC) — a v6-capable guest must not egress around the policy.
   334	            # Best-effort: requires ip6tables (worker nets are v4-only by design, this is belt-and-braces).
   335	            if mac:
   336	                # Insert at the HEAD of FORWARD (like the IPv4 jump) so it beats any permissive
   337	                # IPv6 ACCEPT already in the chain — appending could let v6 slip past a prior accept.
   338	                self._priv(["ip6tables", "-I", "FORWARD", "1", "-m", "mac", "--mac-source", mac, "-j", "DROP"])
   339	        except Exception:
   340	            self.remove(worker_ip, mac=mac, egress_ports=policy.egress_ports)  # roll back fail-closed
   341	            raise
   342	
   343	    def remove(self, worker_ip: str, exit_driver: str | None = None, mac: str | None = None,
   344	               egress_ports: tuple[int, ...] | None = None) -> None:
   345	        # Tear down routing for EVERY driver (a prior incarnation on this IP may have used a different
   346	        # exit), so no orphan nat/policy-route rule survives an exit-driver switch on a reused IP.
   347	        # egress_ports lets a port-scoped tor's per-port REDIRECTs be swept by del-by-match.
   348	        if self._routing is not None:
   349	            for drv in _ROUTING_DRIVERS:
   350	                for cmd in routing_teardown_commands(worker_ip, drv, self._routing, egress_ports):
   351	                    self._priv(cmd)  # best-effort: del-by-match, ignore "not found"
   352	        if mac:
   353	            self._priv(["ip6tables", "-D", "FORWARD", "-m", "mac", "--mac-source", mac, "-j", "DROP"])
   354	            self._priv(["iptables", "-D", "FORWARD", "-m", "mac", "--mac-source", mac,
   355	                        "!", "-s", worker_ip, "-j", "DROP"])  # anti-spoof teardown
   356	        chain = _chain_name(worker_ip)
   357	        while self._ipt_run("-D", "FORWARD", "-s", worker_ip, "-j", chain).returncode == 0:
   358	            pass
   359	        self._ipt_run("-F", chain)
   360	        self._ipt_run("-X", chain)
   361	
   362	    def installed(self, worker_ip: str) -> bool:
   363	        return self._ipt_run("-L", _chain_name(worker_ip)).returncode == 0
     1	"""Libvirt full-VM warm-worker runtime — a snapshot-recycle worker tier.
     2	
     3	The container runtimes (runc/runsc/FC/gVisor) run the engine *inside* the worker. Some
     4	engines can't: they validate/detonate against a full guest OS (e.g. a Windows code-signing
     5	validator) and talk to a **guest agent** over the network. This runtime manages such
     6	workers: a copy-on-write **qcow2 overlay off a read-only golden image**, booted under
     7	libvirt, primed once, then frozen with a libvirt **running-state snapshot** (disk + RAM).
     8	
     9	The warmth model is the same family as the FC-snapshot / gVisor-C/R tiers, at the full-VM
    10	layer:
    11	
    12	  * **Hot path** — a job is just the engine talking to the already-running guest agent over
    13	    `endpoint` (TCP). No boot, no revert. (~0.1-0.5s for the win-validator agent.)
    14	  * **Recycle** — `recycle()` does ``virsh snapshot-revert clean`` (~8s): disk+RAM restored
    15	    to the primed checkpoint, wiping per-job contamination while the agent + any warmed
    16	    caches (CRL/OCSP) survive because they were captured *in* the snapshot. Cheap reset
    17	    between batches, NOT paid per job.
    18	  * **Reprovision** — destroy+undefine+rm overlay → fresh overlay off the golden.
    19	
    20	This implements the engine-agnostic :class:`~blastbox.host.pool.SlotRuntime` shape
    21	(``spawn``/``is_ready``/``is_alive``/``reap``) plus a ``recycle`` extension for the
    22	warm-restore reset. The guest transport (how a job is sent to ``slot.endpoint``) is the
    23	engine's concern; this runtime only owns slot lifecycle, readiness, and snapshot-recycle.
    24	
    25	Prereqs: ``virsh`` (libvirt), ``qemu-img``, a golden qcow2, and a guest that brings up the
    26	agent on ``agent_port`` at boot. Egress policy for the worker's tap/IP is applied separately
    27	(netd libvirt mode); see the network primitive.
    28	"""
    29	from __future__ import annotations
    30	
    31	import logging
    32	import socket
    33	import subprocess
    34	import time
    35	import uuid
    36	from collections.abc import Callable
    37	from dataclasses import dataclass, field
    38	from pathlib import Path
    39	
    40	from blastbox.host.pool import SlotState
    41	from blastbox.host.runtime import guest_ca
    42	from blastbox.host.runtime.libvirt_egress import ExitRouting, LibvirtEgress, VmEgressPolicy
    43	
    44	
    45	logger = logging.getLogger(__name__)
    46	
    47	
    48	def _run(args: list[str], timeout: float = 120) -> subprocess.CompletedProcess:
    49	    try:
    50	        return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    51	    except subprocess.TimeoutExpired:
    52	        return subprocess.CompletedProcess(args, 124, "", "timeout")
    53	
    54	
    55	@dataclass(frozen=True)
    56	class LibvirtVmConfig:
    57	    """How to mint and run one VM worker off a golden image."""
    58	
    59	    golden_base: str
    60	    """Read-only qcow2 the overlays are layered on (COW). Never written."""
    61	
    62	    overlay_dir: str = "/dev/shm"
    63	    """Where per-worker overlays live (tmpfs for RAM-speed recycle/boot)."""
    64	
    65	    agent_port: int = 8765
    66	    """TCP port the in-guest agent listens on — the warm-ready signal + job transport."""
    67	
    68	    mem_mb: int = 4096
    69	    vcpus: int = 2
    70	    network: str = "default"
    71	    """libvirt network the worker NIC attaches to."""
    72	
    73	    machine: str = "pc"
    74	    disk_bus: str = "sata"
    75	    nic_model: str = "e1000"
    76	    subnet_prefix: str = "192.168.122."
    77	    """DHCP subnet of ``network``; used to resolve the worker IP via the host neigh table."""
    78	
    79	    boot_timeout_s: float = 240.0
    80	    """Max wait for the guest to boot + bring the agent up at provision time."""
    81	
    82	    snapshot_name: str = "clean"
    83	    sudo: bool = True
    84	    """Prefix virsh/qemu-img/rm with sudo (libvirt usually needs root)."""
    85	
    86	    egress_policy: VmEgressPolicy | None = None
    87	    """Optional host-side egress policy applied to the worker's IP at spawn, removed at reap
    88	    (the rooter model — see libvirt_egress). None = no per-worker egress rules (worker reaches
    89	    whatever the libvirt network allows)."""
    90	
    91	    gateway: str | None = None
    92	    """Bridge/resolver IP exempted for DNS under ``block_internal``. Defaults to
    93	    ``subnet_prefix + '1'`` (the libvirt default-network gateway) when egress is enabled."""
    94	
    95	    exit_routing: ExitRouting | None = None
    96	    """Rooter-style exit routing endpoints (VPN table/tun, tor ports, FakeNet addr). Needed for
    97	    ``exit=openvpn/wireguard/tor/inetsim`` to actually steer egress through the tunnel/sink; ``direct``
    98	    needs none. None = filter only (the exit driver's routing is a no-op)."""
    99	
   100	    health_check: Callable[["VmSlot"], bool] | None = None
   101	    """Engine-supplied SMOKE TEST: given a ready slot (use ``slot.endpoint``), return True iff the
   102	    worker is actually functional — not just port-open. For a validator: send a known benign sample
   103	    to the agent and assert the expected verdict; for a renderer: render a known doc and check the
   104	    output. Run BEFORE the clean snapshot (so the warm-restore baseline is known-good) and after each
   105	    recycle. A failed smoke means the slot never goes IDLE (re-checked/reaped) — a booted-but-broken
   106	    worker (corrupt cert store, dead .NET, wedged agent) is never handed a real job. None = port-only."""
   107	
   108	    pre_snapshot: Callable[["VmSlot"], None] | None = None
   109	    """Engine hook run AFTER the smoke passes and JUST BEFORE the clean snapshot, to bake transient
   110	    state into the warm baseline. For the cert validator this warms the CRL/OCSP cache (an agent call
   111	    that fetches the common CAs' revocation lists), so every warm-restore inherits a hot cache and
   112	    revocation is served from cache (~tens of ms, no live fetch) rather than re-fetched per job.
   113	    Best-effort: a failure here is logged, not fatal (the worker is already healthy)."""
   114	
   115	    on_ready: Callable[["VmSlot"], None] | None = None
   116	    """Engine hook run EVERY time the worker becomes ready — at first finalize (before the smoke +
   117	    snapshot) AND after each snapshot-revert (in ``recycle``) — to correct environment state before
   118	    use. The canonical use is CLOCK SYNC: both a fresh golden boot and a snapshot-revert can leave a
   119	    wrong/frozen guest clock, and the system clock IS the cert-trust decision (validity windows,
   120	    revocation freshness). The engine resets it to host time the CAPE way — an in-guest
   121	    ``SetLocalTime`` to a host-provided 'now' (no qemu-ga / NTP). The runtime also tries
   122	    ``virsh domtime --sync`` post-revert as a best-effort for qemu-ga goldens. Best-effort, not fatal."""
   123	
   124	    # --- guest TLS trust anchors (for HTTPS/TLS interception workers) ---------
   125	    trust_anchors: list[str] = field(default_factory=list)
   126	    """CA cert files (host paths) to install into the GUEST trust store at finalize, before the
   127	    clean snapshot, so every warm-restore inherits them. The use case is a TLS-interception worker:
   128	    routing its egress through a FakeNet/mitmproxy sinkhole that MITMs HTTPS only decrypts if the
   129	    guest trusts the interceptor's CA. Requires ``guest_ssh_user`` + ``guest_ssh_key``.
   130	    SECURITY: a MITM CA is a trusted root — NEVER set this on a worker whose job is to *judge* trust
   131	    (a cert validator); it would let anything the CA signs validate. Interception workers only."""
   132	    guest_os: str = "windows"
   133	    """``windows`` (LocalMachine\\Root via Import-Certificate) or ``linux`` (ca-certificates dir)."""
   134	    guest_ssh_user: str | None = None
   135	    guest_ssh_key: str | None = None
   136	    guest_ssh_port: int = 22
   137	    """SSH used to push + install ``trust_anchors`` (and available to engines for guest provisioning)."""
   138	
   139	    @property
   140	    def resolved_gateway(self) -> str:
   141	        return self.gateway or (self.subnet_prefix + "1")
   142	
   143	
   144	@dataclass
   145	class VmSlot:
   146	    """One VM worker. Unlike a container Slot this carries a network ``endpoint``
   147	    (the guest agent) rather than control/input/output dirs."""
   148	
   149	    slot_id: str
   150	    domain: str
   151	    overlay: str
   152	    agent_port: int
   153	    ip: str | None = None
   154	    mac: str | None = None
   155	    finalized: bool = False   # egress applied + clean snapshot taken (one-time, on first readiness)
   156	    # Reuse the pool's SlotState vocabulary (spawning/warming/idle/assigned/draining) so the state
   157	    # field matches the Slot contract. NOTE: a VmSlot is not a pool.Slot — it carries a network
   158	    # ``endpoint`` instead of the control/input/output dirs. WarmPool drives this runtime fine
   159	    # anyway because it only touches the common state/jobs/slot_id/spawned_at fields (the engine
   160	    # talks to ``endpoint`` over TCP rather than the file handshake); the static types diverge, so
   161	    # vm_compose's WarmPool construction carries a localized arg-type ignore.
   162	    state: SlotState = SlotState.SPAWNING
   163	    jobs: int = 0
   164	    recycles: int = 0
   165	    spawned_at: float = 0.0
   166	
   167	    @property
   168	    def endpoint(self) -> tuple[str, int] | None:
   169	        return None if self.ip is None else (self.ip, self.agent_port)
   170	
   171	
   172	class LibvirtVmRuntime:
   173	    """SlotRuntime for libvirt full-VM workers with snapshot-recycle.
   174	
   175	    Engine-agnostic: parameterised by a golden image + an agent port. The guest is expected
   176	    to autostart its agent on ``agent_port`` (bake it into the golden as an ONSTART task).
   177	    """
   178	
   179	    def __init__(self, config: LibvirtVmConfig) -> None:
   180	        self.cfg = config
   181	        self._bridge_name: str | None = None  # resolved lazily from cfg.network (cached)
   182	
   183	    # ---- prereq check (fail-closed selection) --------------------------------
   184	    def available(self) -> bool:
   185	        if not Path(self.cfg.golden_base).exists():
   186	            return False
   187	        return _run(self._virsh_argv("version"), timeout=15).returncode == 0
   188	
   189	    # ---- SlotRuntime ---------------------------------------------------------
   190	    def spawn(self) -> VmSlot:
   191	        """Provision a COW overlay off the golden, define+start the domain, and return a WARMING
   192	        slot IMMEDIATELY. Readiness (agent up) and the one-time finalize (egress + clean snapshot)
   193	        happen in ``is_ready()`` so the ~60s guest boot never blocks the pool's tick loop —
   194	        matching the async-spawn contract of the FC/gVisor runtimes."""
   195	        sid = uuid.uuid4().hex[:8]
   196	        name = f"bbvm-{sid}"
   197	        overlay = str(Path(self.cfg.overlay_dir) / f"{name}.qcow2")
   198	        slot = VmSlot(slot_id=sid, domain=name, overlay=overlay,
   199	                      agent_port=self.cfg.agent_port, spawned_at=time.time())
   200	
   201	        self._destroy_domain(name)
   202	        self._sh(["rm", "-f", overlay])
   203	        try:  # any failure → reap (no leaked domain/overlay) and re-raise
   204	            if self._sh(["qemu-img", "create", "-f", "qcow2", "-b", self.cfg.golden_base,
   205	                         "-F", "qcow2", overlay], sudo_tool="qemu-img").returncode != 0:
   206	                raise RuntimeError(f"{name}: qemu-img create overlay off {self.cfg.golden_base} failed")
   207	            self._sh(["chmod", "644", overlay])
   208	            xml_path = f"/tmp/{name}.xml"
   209	            Path(xml_path).write_text(self._domain_xml(name, overlay))
   210	            try:
   211	                if self._virsh("define", xml_path).returncode != 0:
   212	                    raise RuntimeError(f"{name}: virsh define failed")
   213	            finally:
   214	                Path(xml_path).unlink(missing_ok=True)  # don't leave per-spawn XML in /tmp
   215	            if self._virsh("start", name).returncode != 0:
   216	                raise RuntimeError(f"{name}: virsh start failed")
   217	            slot.mac = self._domain_mac(name)
   218	            slot.state = SlotState.WARMING
   219	            return slot
   220	        except Exception:
   221	            self.reap(slot)
   222	            raise
   223	
   224	    def is_ready(self, slot: VmSlot) -> bool:
   225	        """WARMING→ready check (polled by the pool). On the FIRST readiness, finalize once: apply
   226	        egress + take the ``clean`` snapshot. Thereafter just confirm the agent port is live."""
   227	        if slot.finalized:
   228	            return slot.ip is not None and self._port_up(slot.ip, timeout=2)
   229	        ip = slot.ip or self._ip_for_mac(slot.mac)
   230	        if not (ip and self._port_up(ip, timeout=2)):
   231	            return False
   232	        slot.ip = ip
   233	        # FAIL-CLOSED finalize: if applying egress (or any finalize step) RAISES, the guest is
   234	        # already reachable on the libvirt network — reap it rather than leave a booted, un-firewalled
   235	        # VM running until the warming timeout. (A smoke/snapshot that merely returns False is a
   236	        # transient retry, not an error, so it is NOT reaped.)
   237	        try:
   238	            if self.cfg.egress_policy is not None:
   239	                LibvirtEgress(sudo=self.cfg.sudo, routing=self.cfg.exit_routing).apply(
   240	                    ip, self.cfg.egress_policy, self.cfg.resolved_gateway, mac=slot.mac)
   241	            # Correct the clock before the worker is smoked + snapshotted — a fresh golden boot can
   242	            # carry a stale/wrong clock (observed ~7h off), and for a cert validator the clock IS the
   243	            # trust decision, so the baseline must be time-correct. PRIMARY = the libvirt-native
   244	            # `virsh domtime` (qemu-ga, TZ-robust); on_ready is the fallback when qemu-ga isn't up.
   245	            if not self._sync_time(slot.domain):
   246	                self._on_ready(slot)
   247	            # Install guest TLS trust anchors (e.g. a FakeNet/mitmproxy CA for HTTPS interception)
   248	            # BEFORE the snapshot, so every warm-restore inherits them. Best-effort.
   249	            self._install_trust_anchors(slot)
   250	            # SMOKE before snapshot: only checkpoint a worker that actually validates correctly, so
   251	            # the warm-restore baseline is known-good (port-open alone can hide a broken validator).
   252	            if self.cfg.health_check is not None and not self._smoke(slot):
   253	                logger.warning("%s: smoke test failed pre-snapshot; not ready", slot.domain)
   254	                return False
   255	            # Warm transient state (e.g. CRL/OCSP cache) INTO the snapshot. Best-effort.
   256	            if self.cfg.pre_snapshot is not None:
   257	                try:
   258	                    self.cfg.pre_snapshot(slot)
   259	                except Exception:
   260	                    logger.warning("%s: pre_snapshot hook failed (non-fatal)", slot.domain, exc_info=True)
   261	            if self._virsh("snapshot-create-as", slot.domain, self.cfg.snapshot_name,
   262	                           "warm clean checkpoint").returncode != 0:
   263	                logger.warning("%s: snapshot-create-as failed; retry next tick", slot.domain)
   264	                return False
   265	            slot.finalized = True
   266	            return True
   267	        except Exception:
   268	            logger.warning("%s: finalize failed; reaping fail-closed", slot.domain, exc_info=True)
   269	            self.reap(slot)
   270	            return False
   271	
   272	    def _smoke(self, slot: VmSlot) -> bool:
   273	        """Run the engine health_check, treating any exception as unhealthy."""
   274	        try:
   275	            return bool(self.cfg.health_check(slot))  # type: ignore[misc]
   276	        except Exception:
   277	            logger.warning("%s: health_check raised", slot.domain, exc_info=True)
   278	            return False
   279	
   280	    def _on_ready(self, slot: VmSlot) -> None:
   281	        """Run the engine's on_ready hook (clock sync etc.) at each ready transition — first finalize
   282	        and post-revert. Non-fatal: a hook failure must not strand the worker."""
   283	        if self.cfg.on_ready is not None:
   284	            try:
   285	                self.cfg.on_ready(slot)
   286	            except Exception:
   287	                logger.warning("%s: on_ready hook failed (non-fatal)", slot.domain, exc_info=True)
   288	
   289	    def _install_trust_anchors(self, slot: VmSlot) -> None:
   290	        """Push the configured guest CA trust anchors into the worker over SSH (finalize-time, so the
   291	        warm snapshot captures them). No-op unless ``trust_anchors`` + SSH creds are set. Non-fatal."""
   292	        if not (self.cfg.trust_anchors and self.cfg.guest_ssh_user
   293	                and self.cfg.guest_ssh_key and slot.ip):
   294	            return
   295	        try:
   296	            if not guest_ca.install_trust_anchors(
   297	                slot.ip, self.cfg.trust_anchors,
   298	                user=self.cfg.guest_ssh_user, key_path=self.cfg.guest_ssh_key,
   299	                port=self.cfg.guest_ssh_port, guest_os=self.cfg.guest_os,
   300	            ):
   301	                logger.warning("%s: one or more guest trust anchors failed to install "
   302	                               "(HTTPS interception may not decrypt)", slot.domain)
   303	        except Exception:
   304	            logger.warning("%s: trust-anchor install raised (non-fatal)", slot.domain, exc_info=True)
   305	
   306	    def spawn_ready(self, timeout_s: float | None = None) -> VmSlot:
   307	        """Convenience for non-pool callers: spawn() then block until ready (or timeout). The
   308	        WarmPool uses the async spawn()/is_ready() pair instead and never calls this."""
   309	        slot = self.spawn()
   310	        deadline = time.time() + (timeout_s if timeout_s is not None else self.cfg.boot_timeout_s)
   311	        while time.time() < deadline:
   312	            if self.is_ready(slot):
   313	                slot.state = SlotState.IDLE
   314	                return slot
   315	            time.sleep(2)
   316	        self.reap(slot)
   317	        raise RuntimeError(f"{slot.domain}: not ready within {self.cfg.boot_timeout_s:.0f}s")
   318	
   319	    def is_alive(self, slot: VmSlot) -> bool:
   320	        return "running" in self._virsh("domstate", slot.domain).stdout
   321	
   322	    def reap(self, slot: VmSlot) -> None:
   323	        slot.state = SlotState.DRAINING
   324	        if self.cfg.egress_policy is not None and slot.ip is not None:
   325	            LibvirtEgress(sudo=self.cfg.sudo, routing=self.cfg.exit_routing).remove(
   326	                slot.ip, self.cfg.egress_policy.exit_driver, mac=slot.mac,
   327	                egress_ports=self.cfg.egress_policy.egress_ports)  # unhook before IP freed
   328	        self._destroy_domain(slot.domain)
   329	        self._sh(["rm", "-f", slot.overlay])
   330	
   331	    # ---- snapshot-recycle extension -----------------------------------------
   332	    def recycle(self, slot: VmSlot, ready_timeout_s: float = 60.0) -> None:
   333	        """Warm-restore to the ``clean`` snapshot — discards per-job contamination, keeps the
   334	        agent + caches primed. ~8s; use between batches, not per job.
   335	
   336	        Post-revert the guest clock is frozen at snapshot time, so sync it to host time FIRST —
   337	        for a cert validator the system clock IS the trust decision (validity windows, revocation
   338	        freshness). Then confirm the worker is still healthy (smoke) before returning it to IDLE."""
   339	        rv = self._virsh("snapshot-revert", slot.domain, self.cfg.snapshot_name)
   340	        if rv.returncode != 0:
   341	            # The revert FAILED — the guest is still the contaminated post-job VM (its agent port
   342	            # may well still answer). Raise so WarmPool.release() falls back to reap+respawn instead
   343	            # of smoke-checking and returning a dirty slot to IDLE.
   344	            slot.state = SlotState.DRAINING
   345	            raise RuntimeError(
   346	                f"{slot.domain}: snapshot-revert failed (rc={rv.returncode}): {rv.stderr.strip()[:200]}")
   347	        # NB: do NOT reset slot.jobs here — WarmPool owns that counter and uses the cumulative count
   348	        # to enforce max_jobs_per_slot (reap+respawn after M total jobs). Zeroing it would make the
   349	        # reprovision ceiling unreachable. recycles is our own informational tally.
   350	        slot.recycles += 1
   351	        # Sync the clock only AFTER the guest is back on the network: a revert restores the saved
   352	        # RAM state, and qemu-ga's virtio channel (and SSH) take a moment to reconnect — syncing at
   353	        # the instant of revert no-ops and leaves the stale snapshot clock. So wait for the agent
   354	        # port, THEN clock-sync (domtime primary, on_ready fallback), THEN smoke with a correct clock.
   355	        deadline = time.time() + ready_timeout_s
   356	        synced = False
   357	        while time.time() < deadline:
   358	            if slot.ip and self._port_up(slot.ip, timeout=2):
   359	                if not synced:
   360	                    if not self._sync_time(slot.domain):
   361	                        self._on_ready(slot)
   362	                    synced = True
   363	                if self.cfg.health_check is None or self._smoke(slot):
   364	                    # Do NOT set IDLE here. When WarmPool.release() drives recycle the slot must stay
   365	                    # ASSIGNED until release() republishes it under the pool lock — flipping it to
   366	                    # IDLE mid-recycle would let a concurrent claim grab this VM before release()
   367	                    # finishes (double-claim). The caller owns the IDLE transition; recycle just
   368	                    # returns on success / raises on failure.
   369	                    return
   370	            time.sleep(1)
   371	        slot.state = SlotState.DRAINING
   372	        raise RuntimeError(f"{slot.domain}: not healthy/back {ready_timeout_s:.0f}s after revert")
   373	
   374	    def _sync_time(self, domain: str) -> bool:
   375	        """Set the guest clock to the host's real UTC via the QEMU guest agent — the libvirt-native,
   376	        TZ-robust path: qemu-ga sets the guest's UTC system clock, so it's correct for any guest
   377	        timezone. The host must itself hold real time (be NTP-disciplined).
   378	
   379	        Uses an EXPLICIT ``virsh domtime --time <host-utc-epoch>``, NOT ``--sync``: ``--sync`` syncs
   380	        the guest to QEMU's emulated RTC, but a ``snapshot-revert`` rolls that RTC back too — so

