# Cold-path (runsc/runc) ClippyShot worker for blastbox.host.
#
# FROM clippyshot:dev — already provides LibreOffice + the clippyshot package +
# the /opt/clippyshot venv + the non-root `clippy` user (uid 10001). The
# ClippyShotEngine adapter (clippyshot.engine:ClippyShotEngine) is in that venv.
#
# This overlay: (1) force-installs THIS-branch blastbox (which ships
# blastbox.worker.cold) over the pinned PyPI 0.1.3 in the venv, (2) bakes the
# engine selector, (3) sets the generic cold entrypoint. No FC guest / UNO /
# gVisor-shim layers — cold path only. Build context = blastbox repo root.
ARG BASE_IMAGE=clippyshot:dev
FROM ${BASE_IMAGE}

USER root
# Same version string (0.1.3) as PyPI, so force a reinstall of the local source;
# --no-deps keeps the existing dependency closure (worker needs only blastbox core).
COPY pyproject.toml README.md /src/blastbox/
COPY src /src/blastbox/src
RUN /opt/clippyshot/bin/pip install --no-cache-dir --force-reinstall --no-deps /src/blastbox \
    && rm -rf /src \
    && /opt/clippyshot/bin/python -c "import blastbox.worker.cold; print('cold entrypoint present')"

# Engine is fixed per image (operator-configured, never job-derived). The worker
# runs inside the runsc sandbox, so the inner sandbox backend is `container`.
ENV BLASTBOX_ENGINE=clippyshot.engine:ClippyShotEngine \
    CLIPPYSHOT_SANDBOX=container

USER clippy
ENTRYPOINT ["/opt/clippyshot/bin/python", "-m", "blastbox.worker.cold"]
