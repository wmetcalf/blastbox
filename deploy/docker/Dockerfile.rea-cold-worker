# syntax=docker/dockerfile:1
# Cold-path (runsc/runc) worker image for the REA reverse-engineering engine.
#
# REA (github.com/morluto/rea) is a CLI + MCP server that drives Ghidra headless. The
# engine (src/blastbox/engines/rea) runs analyzeHeadless once, then opens the saved
# project through `rea --mcp` in REA's existing-project mode (a private copy, no
# re-import). See deploy/rea/SPIKE.md for the measurements behind every choice here.
#
# EVERYTHING IS PINNED (deploy/rea/PINS records the same values):
#   * REA is BUILT FROM SOURCE at a fixed commit. The npm release (rea-agents 6.8.0)
#     lacks existing-project reuse and ignores REA_GHIDRA_PROJECT_PATH without a
#     warning. The codeload tarball is sha256-checked. `npm pack` is not usable because
#     it runs `prepare` even with --ignore-scripts, so the runtime tree is copied from
#     package.json's own "files" list plus production node_modules.
#   * Ghidra by release URL + sha256; Node by official tarball + sha256 (checked against
#     both the pin and SHASUMS256.txt); the JDK base by digest.
#   * The build smoke asserts REA's tool-catalog digest, so a different REA build fails
#     the image build even though it still says "6.8.0".
#
# FULL JDK, NOT A JRE. Ghidra compiles Java GhidraScripts (REA's bridge, our scripts)
# at run time with javax.tools, which only a JDK has.
#
# NO NETWORK AT RUN TIME. REA's Ghidra bridge is a unix socket in its runtime root.
# frida is an optional dependency whose native binding is never fetched
# (--ignore-scripts), so frida tools stay unavailable, as intended.
#
# WRITABLE STATE. REA puts its runtime root (project copy, logs, fscache, bridge.sock)
# at $TMPDIR/rea-ghidra-XXXX and needs a writable HOME. The engine sets
# TMPDIR=$BLASTBOX_WORK_DIR/tmp and HOME=$BLASTBOX_WORK_DIR/home; the build smoke proves
# REA honours TMPDIR.
#
# Build context = blastbox repo root:
#   docker build -f deploy/docker/Dockerfile.rea-cold-worker -t blastbox-rea:dev .
# Regenerate the committed fixtures (deploy/rea/fixtures/build.sh):
#   docker build -f deploy/docker/Dockerfile.rea-cold-worker --target rea-fixtures \
#     --output type=local,dest=<dir> .

ARG JDK_IMAGE=eclipse-temurin:21-jdk@sha256:ebfbb18d11ff163ee83b21258acf12248af48d22a0fdfdc68fa1a1516c05976a

# ---------------------------------------------------------------- node (pinned tarball)
FROM ${JDK_IMAGE} AS node
ARG NODE_VERSION=v22.23.4
ARG NODE_TARBALL_SHA256=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build/node
RUN tarball="node-${NODE_VERSION}-linux-x64.tar.xz" \
    && curl -fsSLO "https://nodejs.org/dist/${NODE_VERSION}/${tarball}" \
    && curl -fsSLO "https://nodejs.org/dist/${NODE_VERSION}/SHASUMS256.txt" \
    && echo "${NODE_TARBALL_SHA256}  ${tarball}" | sha256sum -c - \
    && grep " ${tarball}\$" SHASUMS256.txt | sha256sum -c - \
    && mkdir -p /opt/node \
    && tar -xJf "${tarball}" -C /opt/node --strip-components=1 \
    && rm -rf /build/node \
    && /opt/node/bin/node --version

# ------------------------------------------------------------ rea (source build, pinned)
FROM node AS rea-build
ARG REA_COMMIT=cd878ad57d3e27e835d0db533c9603b24ae8607a
ARG REA_TARBALL_SHA256=44cec1b6be85a8ccf1576ca397594cdab2aacfbfc316cc817e5f568f7b7ad766
ENV PATH=/opt/node/bin:$PATH
WORKDIR /build
RUN curl -fsSL -o rea.tar.gz "https://codeload.github.com/morluto/rea/tar.gz/${REA_COMMIT}" \
    && echo "${REA_TARBALL_SHA256}  rea.tar.gz" | sha256sum -c - \
    && mkdir src && tar -xzf rea.tar.gz -C src --strip-components=1 && rm rea.tar.gz
WORKDIR /build/src
# Dev deps are needed only to compile (TypeScript + bundler). No install scripts run.
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm run compile \
    && npm prune --omit=dev --ignore-scripts --no-audit --no-fund
# Runtime tree = what `npm pack` would ship (package.json "files", plus package.json
# itself) + production node_modules. Entries that only `prepack` generates (skills,
# npm-shrinkwrap.json) are absent from a source tree and are reported, not faked.
RUN node -e ' \
      const fs = require("fs"), path = require("path"); \
      const pkg = JSON.parse(fs.readFileSync("package.json", "utf8")); \
      const dest = "/opt/rea"; \
      for (const f of ["package.json", "node_modules", ...pkg.files]) { \
        if (!fs.existsSync(f)) { console.log("absent from source tree:", f); continue; } \
        fs.mkdirSync(path.dirname(path.join(dest, f)), { recursive: true }); \
        fs.cpSync(f, path.join(dest, f), { recursive: true, verbatimSymlinks: true }); \
      }' \
    && mkdir -p /opt/rea/bin \
    && printf '#!/bin/sh\nexec /opt/node/bin/node /opt/rea/scripts/rea.mjs "$@"\n' > /opt/rea/bin/rea \
    && chmod 0755 /opt/rea/bin/rea \
    && du -sh /opt/rea

# ------------------------------------------------------------------- ghidra (pinned zip)
FROM node AS ghidra
ARG GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.4_build/ghidra_12.1.4_PUBLIC_20260921.zip
ARG GHIDRA_SHA256=ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN curl -fsSL -o ghidra.zip "${GHIDRA_URL}" \
    && echo "${GHIDRA_SHA256}  ghidra.zip" | sha256sum -c - \
    && unzip -q ghidra.zip -d /build/x && rm ghidra.zip \
    && mv /build/x/ghidra_* /opt/ghidra && rm -rf /build/x

# --------------------------------------------- capa (hash-locked wheels + pinned rules)
# The capa venv's python also runs the sweep's .NET resource scan
# (src/blastbox/engines/rea/dotnet_resources.py), which needs only the stdlib and the hash-locked
# dnfile pinned here for capa; no second copy of dnfile is installed.
# The sweep runs capa after Ghidra. Not the standalone release binary: that is a PyInstaller
# one-file build, which unpacks itself to $TMPDIR and runs from there, and the slot's only
# writable dir (/tmp) is noexec. Rules and FLIRT signatures are the same release's, by sha256.
FROM ${JDK_IMAGE} AS capa
ARG CAPA_RULES_SHA256=3d14dbdaf5b71731e42395ed5fa4d287418e6a2e5d6b0a348c7fd9fbe1699611
ARG CAPA_SRC_SHA256=d3f6006ad61e6591896f524566c191eca89c6220611969e1bd485bd9a1098180
ARG CAPA_VERSION=10.0.0
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates curl python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/rea/capa-requirements.txt /build/capa-requirements.txt
RUN python3 -m venv /opt/capa \
    && /opt/capa/bin/pip install --no-cache-dir --require-hashes --no-deps --only-binary :all: \
       -r /build/capa-requirements.txt \
    && /opt/capa/bin/pip check \
    && /opt/capa/bin/capa --version | grep -qx "capa ${CAPA_VERSION}"
WORKDIR /build
RUN curl -fsSL -o rules.tgz "https://codeload.github.com/mandiant/capa-rules/tar.gz/refs/tags/v${CAPA_VERSION}" \
    && echo "${CAPA_RULES_SHA256}  rules.tgz" | sha256sum -c - \
    && mkdir /opt/capa/rules && tar -xzf rules.tgz -C /opt/capa/rules --strip-components=1 \
    && curl -fsSL -o capa.tgz "https://codeload.github.com/mandiant/capa/tar.gz/refs/tags/v${CAPA_VERSION}" \
    && echo "${CAPA_SRC_SHA256}  capa.tgz" | sha256sum -c - \
    && tar -xzf capa.tgz --strip-components=1 "capa-${CAPA_VERSION}/sigs" \
    && mv sigs /opt/capa/sigs && rm -rf /build/*

# ------------------------------- speakeasy (hash-locked wheels + one pinned pure-Python sdist)
# The sweep's emulated unpacking (src/blastbox/engines/rea/emulate.py) runs emulate_runner.py under
# /opt/speakeasy/bin/python as a bounded subprocess: unicorn interprets the stub, nothing runs
# natively. Wheels as for capa (speakeasy-requirements.txt). lznt1 (a Speakeasy dependency) ships
# only as a pure-Python sdist: it is sha256-checked and turned into a wheel here with a hash-locked
# setuptools, offline and without build isolation; the build venv stays in this stage.
FROM ${JDK_IMAGE} AS speakeasy
ARG SPEAKEASY_VERSION=2.0.0b9
ARG LZNT1_SDIST_URL=https://files.pythonhosted.org/packages/72/c2/087cd4845836f0eddd17cb4e99f92f4ef2087074de6e0ca8253f47e83524/lznt1-0.2.tar.gz
ARG LZNT1_SDIST_SHA256=fdc59b57d462003038d572b17e165aa3c8f91a33df68948a344969a2896bc2ea
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates curl python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/rea/speakeasy-requirements.txt deploy/rea/speakeasy-build-requirements.txt /build/
WORKDIR /build
RUN python3 -m venv /build/bv \
    && /build/bv/bin/pip install --no-cache-dir --require-hashes --no-deps --only-binary :all: \
       -r /build/speakeasy-build-requirements.txt \
    && curl -fsSL -o lznt1-0.2.tar.gz "${LZNT1_SDIST_URL}" \
    && echo "${LZNT1_SDIST_SHA256}  lznt1-0.2.tar.gz" | sha256sum -c - \
    && /build/bv/bin/pip wheel --no-cache-dir --no-deps --no-build-isolation --no-index -w /build/wheels \
       ./lznt1-0.2.tar.gz \
    && python3 -m venv /opt/speakeasy \
    && /opt/speakeasy/bin/pip install --no-cache-dir --require-hashes --no-deps --only-binary :all: \
       -r /build/speakeasy-requirements.txt \
    && /opt/speakeasy/bin/pip install --no-cache-dir --no-deps --no-index /build/wheels/lznt1-0.2-py3-none-any.whl \
    && /opt/speakeasy/bin/pip check \
    && /opt/speakeasy/bin/python -I -c "import importlib.metadata as m, speakeasy, unicorn; assert m.version('speakeasy-emulator') == '${SPEAKEASY_VERSION}'; print('speakeasy', m.version('speakeasy-emulator'), 'unicorn', unicorn.__version__)" \
    && rm -rf /build

# ------------------------- refinery (hash-locked wheels + one pinned pure-Python sdist, unpacked)
# The sweep unwraps Inno Setup installers with Binary Refinery's xtinno parser
# (src/blastbox/engines/rea/inno_unwrap.py, run under /opt/refinery/bin/python as a bounded
# subprocess; a parser, nothing runs). PyPI has only an sdist, and its setup.py imports the package
# and every optional dependency to build; none of that is needed: the package is pure Python (its
# Cython extensions are optional accelerators with pure-Python twins), so the sha256-checked sdist's
# refinery/ tree is unpacked into the venv as-is and no build runs. Only the three packages xtinno
# imports are installed (refinery-requirements.txt). Refinery declares more (lief, msgpack,
# colorama, toml...) for units the sweep never loads, so there is no `pip check` here, and no
# console scripts.
FROM ${JDK_IMAGE} AS refinery
ARG REFINERY_VERSION=0.11.3
ARG REFINERY_SDIST_URL=https://files.pythonhosted.org/packages/3d/4a/0bd600f4f86f33bdf7bdc60d332a5cc33a2f9b8411a0eedec26ce8203164/binary_refinery-0.11.3.tar.gz
ARG REFINERY_SDIST_SHA256=8b5bf2113939cb1e2b8ca234ba40bef07aff87a33685dfcbdc7105d59675a520
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates curl python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/rea/refinery-requirements.txt /build/
WORKDIR /build
RUN python3 -m venv /opt/refinery \
    && /opt/refinery/bin/pip install --no-cache-dir --require-hashes --no-deps --only-binary :all: \
       -r /build/refinery-requirements.txt \
    && curl -fsSL -o refinery.tar.gz "${REFINERY_SDIST_URL}" \
    && echo "${REFINERY_SDIST_SHA256}  refinery.tar.gz" | sha256sum -c - \
    && site=$(/opt/refinery/bin/python -I -c "import sysconfig; print(sysconfig.get_path('purelib'))") \
    && tar -xzf refinery.tar.gz -C "$site" --strip-components=1 --no-same-owner --no-same-permissions \
       "binary_refinery-${REFINERY_VERSION}/refinery" \
    && /opt/refinery/bin/python -I -m compileall -q "$site/refinery" \
    && /opt/refinery/bin/python -I -c "import refinery; assert refinery.__version__ == '${REFINERY_VERSION}', refinery.__version__; from refinery.units.formats.archive.xtinno import xtinno; print('refinery', refinery.__version__, xtinno.__name__)" \
    && rm -rf /build

# ------------------------------- yara (hash-locked YARA-X wheel + CAPE's rules, compiled once here)
# The sweep's signature step (src/blastbox/engines/rea/signatures.py) runs signatures_runner.py under
# /opt/yara/bin/python as a bounded subprocess: YARA-X matches the submitted file and every recovered
# stage against CAPEv2's family rules (data/yara/CAPE). The rules come from a commit-pinned,
# sha256-checked codeload tarball (GPL-3.0, see deploy/rea/PINS); they are not vendored. Each rule file
# is compiled on its own first and skipped when it does not compile; the rest are compiled into one
# rule set, serialized to /opt/yara/cape.yarx (loaded at run time, no compile per job). The build
# fails when fewer than CAPE_RULES_MIN rules compiled. The compile report stays next to it.
FROM ${JDK_IMAGE} AS yara
ARG YARA_X_VERSION=1.22.1
ARG CAPE_COMMIT=5ee1155a30c46e50c0f1cb6272c724979a1d61bf
ARG CAPE_TARBALL_SHA256=680ecbf561c4d5326082a52159d054e5aeec5917833f357e3beadbe5b7631219
ARG CAPE_RULES_MIN=135
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates curl python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/rea/yara-requirements.txt /build/yara-requirements.txt
COPY src/blastbox/engines/rea/signatures_runner.py /build/signatures_runner.py
WORKDIR /build
RUN python3 -m venv /opt/yara \
    && /opt/yara/bin/pip install --no-cache-dir --require-hashes --no-deps --only-binary :all: \
       -r /build/yara-requirements.txt \
    && /opt/yara/bin/pip check \
    && /opt/yara/bin/python -I -c "import importlib.metadata as m, yara_x; assert m.version('yara-x') == '${YARA_X_VERSION}'; print('yara-x', m.version('yara-x'))" \
    && curl -fsSL -o cape.tgz "https://codeload.github.com/kevoreilly/CAPEv2/tar.gz/${CAPE_COMMIT}" \
    && echo "${CAPE_TARBALL_SHA256}  cape.tgz" | sha256sum -c - \
    && mkdir /build/cape \
    && tar -xzf cape.tgz -C /build/cape --strip-components=4 "CAPEv2-${CAPE_COMMIT}/data/yara/CAPE" \
    && tar -xzf cape.tgz -O "CAPEv2-${CAPE_COMMIT}/LICENSE" > /opt/yara/CAPE-LICENSE \
    && /opt/yara/bin/python -I /build/signatures_runner.py compile /build/cape /opt/yara/cape.yarx "${CAPE_RULES_MIN}" \
       > /opt/yara/cape-compile.json \
    || { cat /opt/yara/cape-compile.json 2>/dev/null; exit 1; }; \
    /opt/yara/bin/python -I -c "import json; d=json.load(open('/opt/yara/cape-compile.json')); print('CAPE rules compiled:', d['rules'], 'from', d['compiled_files'], 'of', d['files'], 'files; skipped:', [s['file'] for s in d['skipped']])" \
    && chmod -R a+rX /opt/yara && rm -rf /build

# ------------------------------------ ilspy (pinned .NET runtime + ilspycmd nupkg)
# The sweep decompiles .NET assemblies (the sample and the .NET stages dotnet_resources recovers)
# to C# with ILSpy's command-line front end (src/blastbox/engines/rea/dotnet_decompile.py, run as a
# bounded subprocess: ulimit -v/-f, timeout, stdout cap, process-group kill). Decompiling reads IL
# and metadata; the assembly never runs.
# No SDK and no `dotnet tool install`: the ilspycmd .nupkg is a zip, sha512-checked against the pin
# (= nuget.org's packageHash) and its tools/net10.0/any tree unpacked to /opt/ilspycmd; it runs as
# `/opt/dotnet/dotnet /opt/ilspycmd/ilspycmd.dll`. The runtime is Microsoft's linux-x64 tarball,
# sha512-checked against the pin (= the hash in Microsoft's 10.0 releases.json). The runtime needs
# only libc/libstdc++/libgcc_s/zlib (in the base image); ICU is not needed (invariant
# globalization, set in ilspycmd.runtimeconfig.json and again by the engine). Dropped from the
# nupkg tree: the 1.2 MB XML API docs, the .pdb and the Windows-only runtimes/win assets.
FROM ${JDK_IMAGE} AS ilspy
ARG DOTNET_RUNTIME_VERSION=10.0.14
ARG DOTNET_RUNTIME_SHA512=634326028645f38731c8c4e71a68356e4ca0d6b6607139a234ab760687f742063edaf33a1f20dda615742d2dc8300ca2ff857619d51fbb38090383b71334af89
ARG ILSPYCMD_VERSION=11.1.0.9782
ARG ILSPYCMD_SHA512=17b0a5bbfad858fb7d7c29432f3660597234376fd1b78e2de6d3ae90e61466dd6d23c930653098f3311956022bede4e425086e645256e9127c1f34429709c842
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN curl -fsSL -o runtime.tgz \
       "https://builds.dotnet.microsoft.com/dotnet/Runtime/${DOTNET_RUNTIME_VERSION}/dotnet-runtime-${DOTNET_RUNTIME_VERSION}-linux-x64.tar.gz" \
    && echo "${DOTNET_RUNTIME_SHA512}  runtime.tgz" | sha512sum -c - \
    && mkdir /opt/dotnet && tar -xzf runtime.tgz -C /opt/dotnet --no-same-owner \
    && curl -fsSL -o ilspycmd.nupkg \
       "https://api.nuget.org/v3-flatcontainer/ilspycmd/${ILSPYCMD_VERSION}/ilspycmd.${ILSPYCMD_VERSION}.nupkg" \
    && echo "${ILSPYCMD_SHA512}  ilspycmd.nupkg" | sha512sum -c - \
    && unzip -q ilspycmd.nupkg 'tools/net10.0/any/*' -d /build/x \
    && mv /build/x/tools/net10.0/any /opt/ilspycmd \
    && rm -rf /opt/ilspycmd/runtimes /opt/ilspycmd/ICSharpCode.Decompiler.xml /opt/ilspycmd/ilspycmd.pdb \
    && chmod -R a+rX,go-w /opt/dotnet /opt/ilspycmd \
    && DOTNET_CLI_TELEMETRY_OPTOUT=1 /opt/dotnet/dotnet /opt/ilspycmd/ilspycmd.dll --version \
       | grep -q "ICSharpCode.Decompiler: ${ILSPYCMD_VERSION}" \
    && rm -rf /build

# ------------------------------------------- fixtures (regeneration only; not in image)
FROM ${JDK_IMAGE} AS rea-fixtures-build
ARG NSIS_VERSION=3.10-2ubuntu2
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       gcc libc6-dev gcc-mingw-w64-x86-64 binutils-mingw-w64-x86-64 python3 "nsis=${NSIS_VERSION}" \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/rea/fixtures /src/fixtures
RUN sh /src/fixtures/build.sh /out

FROM scratch AS rea-fixtures
COPY --from=rea-fixtures-build /out/ /

# -------------------------------------------------------------------------- final image
FROM ${JDK_IMAGE}
# REA's MCP tool-catalog digest for the pinned commit (see deploy/rea/PINS).
ARG REA_TOOLS_SHA256=c819d694c65bd1482a0e780ff1848542f2046fe50a6b68fc366066b593d7e58f
# The sweep upx -d-s UPX-marked samples (a static decompressor; the sample never runs).
ARG UPX_VERSION=4.2.4-1.1build1
# The sweep unwraps NSIS installers with 7-Zip (7z x -tNsis; a static decompressor, the installer
# never runs). Inno Setup goes through the refinery venv above. See installer.UNWRAPPERS.
ARG SEVENZIP_VERSION=26.00+dfsg-1
# Address-space cap (KiB) on each Ghidra decompiler process. Auto-analysis runs one per
# analysis thread; on a .NET assembly each grew past 1 GiB until the 6 GiB slot was
# OOM-killed with no output. Capped, a runaway function fails alone and analysis goes on.
ARG DECOMPILE_MAX_KB=786432

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       procps python3 python3-venv "upx-ucl=${UPX_VERSION}" \
       "7zip=${SEVENZIP_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && upx --version | head -1 \
    && 7z i | grep -q ' Nsis ' \
    && useradd -u 10001 -m worker

COPY --from=node /opt/node /opt/node
COPY --from=ghidra /opt/ghidra /opt/ghidra
RUN d=/opt/ghidra/Ghidra/Features/Decompiler/os/linux_x86_64 \
    && mv "$d/decompile" "$d/decompile.bin" \
    && printf '#!/bin/sh\nulimit -v %s || exit 1\nexec "$0.bin" "$@"\n' "${DECOMPILE_MAX_KB}" > "$d/decompile" \
    && chmod 755 "$d/decompile"
COPY --from=rea-build /opt/rea /opt/rea
COPY --from=capa /opt/capa /opt/capa
COPY --from=speakeasy /opt/speakeasy /opt/speakeasy
COPY --from=refinery /opt/refinery /opt/refinery
COPY --from=yara /opt/yara /opt/yara
# dotnet_decompile.py calls /opt/dotnet/dotnet by absolute path and sets every DOTNET_* variable
# itself; nothing else in the image runs .NET, so no PATH change.
COPY --from=ilspy /opt/dotnet /opt/dotnet
COPY --from=ilspy /opt/ilspycmd /opt/ilspycmd
COPY deploy/rea/ghidra_scripts /opt/rea/ghidra_scripts

COPY pyproject.toml README.md /src/blastbox/
COPY src /src/blastbox/src
RUN python3 -m venv /opt/blastbox \
    && /opt/blastbox/bin/pip install --no-cache-dir "/src/blastbox[rea]" \
    && rm -rf /src \
    && /opt/blastbox/bin/python -c "from blastbox.engines.rea import apihash; assert len(apihash._names()) > 10000"

# Operator-fixed engine, never job-derived. `rea-agent` images override BLASTBOX_ENGINE
# with blastbox.engines.rea:ReaAgentEngine.
ENV PATH=/opt/blastbox/bin:/opt/node/bin:$PATH \
    BLASTBOX_ENGINE=blastbox.engines.rea:ReaSweepEngine \
    BLASTBOX_DETONATE_NAME=rea \
    GHIDRA_INSTALL_DIR=/opt/ghidra \
    REA_BIN=/opt/rea/bin/rea \
    REA_GHIDRA_SCRIPTS=/opt/rea/ghidra_scripts \
    REA_ANALYSIS_PROVIDER=ghidra

USER 10001:10001

# A BARE analyzeHeadless IGNORES $HOME AND $TMPDIR: the JVM takes user.home from
# /etc/passwd (Ghidra writes ~/.config/ghidra there), java.io.tmpdir defaults to /tmp
# (/tmp/<user>-ghidra, /tmp/hsperfdata_<user>), and without XDG_CACHE_HOME Ghidra's
# cache goes to /var/tmp/<user>-ghidra. On a read-only rootfs it fails with
# "java_home.save (Read-only file system)". Whoever runs analyzeHeadless must pass
#   XDG_CACHE_HOME=$HOME/.cache XDG_CONFIG_HOME=$HOME/.config
#   JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=$TMPDIR -Duser.home=$HOME -XX:-UsePerfData"
# as below (verified to leave /tmp and /var/tmp untouched). `rea --mcp` honours $TMPDIR: its runtime root lands there and it hands
# Ghidra -Duser.home/-Djava.io.tmpdir inside that root. One residue it does not control
# on Linux: its JVM creates /tmp/hsperfdata_<user> (REA adds -XX:-UsePerfData only on
# win32 and drops JAVA_TOOL_OPTIONS/_JAVA_OPTIONS/JDK_JAVA_OPTIONS from the environment
# it passes on). That write is non-fatal: with a read-only /tmp the session still
# succeeds (verified). The smoke allows exactly that one path and fails on anything else
# written outside HOME/TMPDIR.
#
# Build-time smoke, as the worker user, in a scratch dir that is removed afterwards
# (fixtures and the driver are bind-mounted, so they never enter a layer). Any failure
# fails the build. HOME and TMPDIR are pointed into the scratch dir exactly as the
# engine does at run time.
RUN --mount=type=bind,source=deploy/rea,target=/mnt/rea \
    set -eu; \
    w=/home/worker/smoke; mkdir -p "$w/home" "$w/tmp" "$w/proj" "$w/in"; touch "$w/.start"; \
    export HOME="$w/home" TMPDIR="$w/tmp"; \
    cp /mnt/rea/fixtures/sample.elf "$w/in/sample.elf"; \
    echo '== rea --version --json'; rea_out=$("$REA_BIN" --version --json); echo "$rea_out"; \
    echo '== rea providers --json | grep ghidra'; "$REA_BIN" providers --json | grep -q ghidra; \
    echo '== analyzeHeadless (ELF fixture)'; \
    XDG_CACHE_HOME="$HOME/.cache" XDG_CONFIG_HOME="$HOME/.config" \
    JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=$TMPDIR -Duser.home=$HOME -XX:-UsePerfData" \
    /opt/ghidra/support/analyzeHeadless "$w/proj" sample -import "$w/in/sample.elf" \
        > "$w/ah.log" 2>&1 || { tail -50 "$w/ah.log"; exit 1; }; \
    grep -E 'Import succeeded|REPORT: Save succeeded' "$w/ah.log"; \
    echo '== rea --mcp over the saved project'; \
    REA_GHIDRA_PROJECT_PATH="$w/proj/sample.gpr" REA_GHIDRA_PROGRAM_NAME=sample.elf \
        python -I /mnt/rea/smoke_mcp.py "$w/in/sample.elf" "$REA_TOOLS_SHA256"; \
    echo '== capa (ELF fixture)'; \
    /opt/capa/bin/capa -j -q -f elf -b vivisect -r /opt/capa/rules -s /opt/capa/sigs -- "$w/in/sample.elf" \
        > "$w/capa.json"; \
    python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print('capa rules matched:', len(d['rules']))" \
        "$w/capa.json"; \
    echo '== NSIS fixture unwrapped by 7z'; \
    7z x -tNsis -y -bd -bso0 -bsp0 -o"$w/nsis" -- /mnt/rea/fixtures/installer.exe; \
    cmp "$w/nsis/payload.exe" /mnt/rea/fixtures/sample.exe; \
    echo '== Inno unwrapper (refinery venv) loads its parser and refuses the NSIS fixture with status 1'; \
    unwrapper=$(python -c 'import blastbox.engines.rea.inno_unwrap as m; print(m.__file__)'); \
    /opt/refinery/bin/python -I -c 'from refinery.units.formats.archive.xtinno import xtinno'; \
    rc=0; /opt/refinery/bin/python -I "$unwrapper" /mnt/rea/fixtures/installer.exe "$w/inno" 1048576 || rc=$?; \
    [ "$rc" = 1 ] && [ -z "$(ls -A "$w/inno")" ]; \
    echo '== .NET resource scan (capa venv python, hash-locked dnfile) over the dotnet fixture'; \
    scanner=$(python -c 'import blastbox.engines.rea.dotnet_resources as m; print(m.__file__)'); \
    /opt/capa/bin/python -I "$scanner" /mnt/rea/fixtures/dotnet.dll "$w/dres" > "$w/dres.json"; \
    python3 -c "import json,sys; d=json.load(open(sys.argv[1])); assert d['resources_total'] == 6 and len(d['hidden']) == 5, d; print('hidden payloads:', len(d['hidden']))" \
        "$w/dres.json"; \
    echo '== emulated unpacking (speakeasy venv, unicorn only) of the loader fixture under its ulimits'; \
    runner=$(python -c 'import blastbox.engines.rea.emulate_runner as m; print(m.__file__)'); \
    mkdir "$w/emu"; \
    sh -c 'ulimit -v 3145728 && ulimit -f 655360 && exec /opt/speakeasy/bin/python -I "$@"' sh \
        "$runner" /mnt/rea/fixtures/unpack.exe "$w/emu" 60 20000 -1 > "$w/emu.json"; \
    python3 -c "import json,sys; d=json.load(open(sys.argv[1])); assert not d.get('error') and len(d['regions']) == 3 and d['dynamic_code'], d; print('emulation regions:', len(d['regions']), 'apis:', d['apis_total'])" \
        "$w/emu.json"; \
    echo '== YARA-X signatures (yara venv): the compiled CAPE rules load and match nothing in the benign fixture'; \
    sigrunner=$(python -c 'import blastbox.engines.rea.signatures_runner as m; print(m.__file__)'); \
    sh -c 'ulimit -d 2097152 && ulimit -f 0 && exec /opt/yara/bin/python -I "$@"' sh \
        "$sigrunner" scan /opt/yara/cape.yarx 67108864 30 /mnt/rea/fixtures/sample.exe | cat > "$w/sig.json"; \
    python3 -c "import json,sys; l=[json.loads(x) for x in open(sys.argv[1])]; n=json.load(open('/opt/yara/cape-compile.json'))['rules']; assert l[0] == {'rules_total': n} and l[1]['matches'] == [] and l[-1] == {'done': True}, l; print('CAPE rules loaded:', n)" \
        "$w/sig.json"; \
    echo '== YARA-X signatures: a benign rule compiled here matches the benign fixture'; \
    mkdir "$w/yr"; \
    printf 'rule BenignFixture {\n  meta:\n    cape_type = "BenignFixture Payload"\n  strings:\n    $a = "This program cannot be run in DOS mode"\n  condition:\n    uint16(0) == 0x5A4D and $a\n}\n' > "$w/yr/benign.yar"; \
    /opt/yara/bin/python -I "$sigrunner" compile "$w/yr" "$w/benign.yarx" 1 | grep -q '"rules": 1'; \
    sh -c 'ulimit -d 2097152 && ulimit -f 0 && exec /opt/yara/bin/python -I "$@"' sh \
        "$sigrunner" scan "$w/benign.yarx" 67108864 30 /mnt/rea/fixtures/sample.exe | grep -q '"rule": "BenignFixture"'; \
    echo '== ilspycmd (.NET runtime) decompiles the dotnet fixture'; \
    python -I -c "import sys, json; from pathlib import Path; from blastbox.engines.rea import dotnet_decompile as d; \
r = d.decompile(Path('/mnt/rea/fixtures/dotnet.dll'), Path(sys.argv[1]), timeout_s=120); \
assert r.status == 'ok', (r.status, r.reason); g = d.digest(r, label='fixture', budget_chars=30000); \
assert g and g['entry_point'] == 'Fixture.Program.Main' and g['excerpts'][1]['member'] == 'LoadHidden', g; \
print('ilspy', r.tool, 'types', r.types_total, 'methods', r.methods_total, 'chars', r.source_chars)" "$w/il"; \
    echo '== import blastbox.engines.rea'; \
    python -c "import blastbox.worker.cold, blastbox.engines.rea, pefile, PIL; print('blastbox rea worker ready')"; \
    echo '== nothing written outside HOME/TMPDIR'; \
    leaks=$(find /tmp /var/tmp /home/worker -mindepth 1 -newer "$w/.start" -not -path "$w" -not -path "$w/*" \
        -not -path /tmp/hsperfdata_worker -not -path '/tmp/hsperfdata_worker/*'); \
    if [ -n "$leaks" ]; then echo "FAIL writes outside HOME/TMPDIR: $leaks"; exit 1; fi; \
    echo 'only /tmp/hsperfdata_worker (JVM perf counters, non-fatal if unwritable)'; \
    rm -rf "$w" /tmp/hsperfdata_worker

WORKDIR /home/worker
ENTRYPOINT ["python", "-m", "blastbox.worker.cold"]

LABEL org.opencontainers.image.title="blastbox-rea-cold-worker" \
      org.opencontainers.image.description="REA reverse-engineering worker (REA source build cd878ad, Ghidra 12.1.4 headless, Temurin JDK 21, Node 22.23.4, 7-Zip 26.00, Binary Refinery 0.11.3, Speakeasy 2.0.0b9, YARA-X 1.22.1 + CAPEv2 rules 5ee1155, ILSpy 11.1.0.9782 on .NET runtime 10.0.14)" \
      org.opencontainers.image.version="0.1.0"
