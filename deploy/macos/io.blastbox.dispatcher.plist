<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for the dispatcher (blastbox dispatch), usually a static pool of local/LAN Mac agents, for a Mac-only deployment
  (ingress + dispatcher + worker agent on one Mac). On a mixed fleet run these on Linux instead
  and keep only io.blastbox.worker-agent on the Macs.

  Configuration comes from ONE env file (KEY=value lines, sourced with `set -a`), so serve and
  dispatch can't drift apart: they must agree on BLASTBOX_DATABASE_URL, BLASTBOX_JOB_ROOT and
  every BLASTBOX_ENGINE_<NAME>_* knob. Keep it 0600: it holds the worker-agent token. For the
  dispatcher it needs at least:

    BLASTBOX_POOL_RUNTIME=static
    BLASTBOX_STATIC_WORKERS=127.0.0.1:8765
    BLASTBOX_STATIC_WORKER_TOKEN=<the agent's BLASTBOX_WORKER_AGENT_TOKEN, same value>

  (without the token every /healthz probe gets 401 and the dispatcher refuses the fleet).

    cp io.blastbox.dispatcher.plist ~/Library/LaunchAgents/
    # edit the two REPLACE_ME paths below
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/io.blastbox.dispatcher.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.blastbox.dispatcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . "$BLASTBOX_ENV_FILE"; set +a; exec "$BLASTBOX_BIN" dispatch</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BLASTBOX_ENV_FILE</key>
    <string>REPLACE_ME/blastbox-host.env</string>
    <key>BLASTBOX_BIN</key>
    <string>REPLACE_ME/venv/bin/blastbox</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- A static pool refuses to start until a worker answers /healthz, and the worker agent runs
       its engine's self-test first. launchd restarts the dispatcher until the agent is up. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/blastbox-dispatcher.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/blastbox-dispatcher.log</string>
</dict>
</plist>
