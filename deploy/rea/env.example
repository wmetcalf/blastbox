# rea-bb stack (compose.yml). Keep the real .env 0600: it holds the ingress bearer key and the
# database password.

POSTGRES_PASSWORD=REPLACE_ME          # e.g. `openssl rand -hex 24`
BLASTBOX_API_KEY=REPLACE_ME           # ingress bearer key, e.g. `openssl rand -hex 32`
                                      # Loadout: LOADOUT_REA_API_KEY / LOADOUT_REA_AGENT_API_KEY

REA_DATA_DIR=REPLACE_ME               # host dir owned by uid 10001 (jobs; shared by api + dispatcher).
                                      # Mounted at the SAME path inside both: the dispatcher hands
                                      # host paths to `docker run --mount`.
REA_KEY_DIR=REPLACE_ME                # host dir, uid 10001, 0700, NOT inside the data dir (attest.key)
REA_TLS_DIR=REPLACE_ME                # ingress.crt, ingress.key, ca.crt readable by uid 10001
REA_PORT=8006                         # Loadout: LOADOUT_REA_URL=https://<host>:8006; Loadout trusts
                                      # ca.crt via SSL_CERT_FILE=<system bundle + ca.crt> (README)
# REA_BIND_ADDR=0.0.0.0
# REA_CONCURRENCY=1                   # parallel cold slots (each: 4 CPUs, 6 GiB). toolz2 runs 1 (Ruling AN):
#                                     # the model serves one sequence, and this one count covers rea AND rea-agent
# REA_MODEL_PROXY_IP=10.231.200.2     # must sit in bb-rea-model's subnet and match tinyproxy.conf Listen

# Agent tuning knobs are reserved keys: they are NOT read from this file. Their values are the
# engine defaults unless baked into the agent image (Dockerfile.stack-worker ENV); see README.
#   REA_TURN_MAX_TOKENS=2048          completion tokens per tool-choice turn
#   REA_MAX_COMPLETION_TOKENS=4096    completion tokens for the final answer (was 8192)
#   REA_MODEL_TOKENS_PER_S=30         endpoint throughput; sizes the final-answer reserve and
#                                     the one shorter retry of an unusable final answer
#   REA_FINAL_THINKING=               unset (default): the final answer asks vLLM for
#                                     chat_template_kwargs {"thinking": false}; 1 keeps reasoning on
#   REA_REPORT_MAX_TOKENS=3500        completion tokens for the analysis report (rea.analysis/1);
#                                     0 turns the report call off
#   REA_RESERVE_TOKENS=4096           tokens the final reserve plans for (final answer + report,
#                                     sized to measured use, not the two caps); 1.25 x 4096 / 30
#                                     = 171 s of the 540 s pass
#   REA_MODEL_TIMEOUT_S=              unset (default): each request gets the time left in its
#                                     phase; set only as an upper cap (was a fixed 240 s)

REA_HOST_IMAGE=blastbox-rea-host:REPLACE_ME
REA_SWEEP_IMAGE=blastbox-rea-sweep:REPLACE_ME
REA_AGENT_IMAGE=blastbox-rea-agent:REPLACE_ME
