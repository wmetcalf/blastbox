# .NET decompile (dotnet_decompile.py): ILSpy's command-line front end on the .NET runtime, in the
# Dockerfile's ilspy stage, copied to /opt/dotnet and /opt/ilspycmd. Run as
# `/opt/dotnet/dotnet /opt/ilspycmd/ilspycmd.dll` (no SDK, no `dotnet tool install`, no network at run
# time; ilspycmd's own update check is turned off with --disable-updatecheck on every call).
# ilspycmd 11.1.0.9782 (nuget.org, published 2026-09-23; ICSharpCode.Decompiler 11.1.0.9782): the
# release before 11.2.0.10050, which was 14 days old on 2026-11-10. Targets net10.0. The .nupkg is a
# zip; its tools/net10.0/any tree is unpacked as-is (XML API docs, .pdb and Windows-only runtimes/win
# dropped). ILSPYCMD_SHA512 is nuget.org's packageHash for the package (catalog entry
# 2026.09.23.06.00.50), checked with sha512sum.
ILSPYCMD_VERSION=11.1.0.9782
ILSPYCMD_URL=https://api.nuget.org/v3-flatcontainer/ilspycmd/11.1.0.9782/ilspycmd.11.1.0.9782.nupkg
