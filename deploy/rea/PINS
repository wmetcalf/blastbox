REA_TARBALL_URL=https://codeload.github.com/morluto/rea/tar.gz/cd878ad57d3e27e835d0db533c9603b24ae8607a
REA_TARBALL_SHA256=44cec1b6be85a8ccf1576ca397594cdab2aacfbfc316cc817e5f568f7b7ad766
