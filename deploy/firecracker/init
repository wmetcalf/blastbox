#!/bin/sh
# PID 1 inside the blastbox FC microVM. The root fs is mounted read-only; the
# only writable surface is the output disk (/dev/vdb) and tmpfs.
#
# Brings up /proc,/sys,/dev, mounts the output disk, hands the writable surfaces
# to a non-root user, then DROPS PRIVILEGES and execs the guest agent — the
# untrusted document is processed as non-root (defence in depth under the VM).
# The host reaps the slot by SIGKILLing firecracker, so the guest never powers off.

# Per-rootfs config (defaults suit the python-slim rootfs); an adopter rootfs such
# as clippyshot overrides via /opt/blastbox/guest.env (e.g. DROP_USER=clippy +
# engine-specific exports like CLIPPYSHOT_SANDBOX=container).
DROP_USER=blastbox
GUEST_HOME=/tmp
[ -f /opt/blastbox/guest.env ] && . /opt/blastbox/guest.env

# PID 1 has no inherited PATH; setpriv execs via execvp (PATH lookup), unlike
# dash's exec. List the clippyshot venv first (its python), then the slim base.
export PATH=/opt/clippyshot/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export HOME="$GUEST_HOME"

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sys /sys 2>/dev/null
# Most FC kernels auto-mount devtmpfs; mount it too in case they don't.
mount -t devtmpfs dev /dev 2>/dev/null
# POSIX shared memory — required by multiprocessing.SemLock(), which pypdfium2's
# page-render pool uses; without /dev/shm, multi-page rasterize fails (FileNotFound/
# PermissionError on the semaphore). The devtmpfs above doesn't provide it.
mkdir -p /dev/shm 2>/dev/null
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm 2>/dev/null \
    || echo "blastbox-fc-guest: WARNING /dev/shm tmpfs mount failed; multiprocessing rasterize may fail" > /dev/console 2>&1
# tmpfs /tmp, sticky world-writable (1777) so the non-root agent can create
# /tmp/in (input scratch) and any tool profiles. Kept OFF the output disk so
# rdump returns only artifacts + metadata.json.
mount -t tmpfs -o mode=1777 tmpfs /tmp 2>/dev/null \
    || echo "blastbox-fc-guest: WARNING /tmp tmpfs mount failed; scratch lands on the read-only root (conversions will fail-closed, not leak)" > /dev/console 2>&1
mkdir -p /mnt/outdisk 2>/dev/null
mount -t ext4 /dev/vdb /mnt/outdisk 2>/dev/null \
    || echo "blastbox-fc-guest: ERROR /dev/vdb -> /mnt/outdisk mount failed; no output will be captured" > /dev/console 2>&1
# The fresh ext4 root dir is owned by root; hand it to the non-root agent.
chown "$DROP_USER:$DROP_USER" /mnt/outdisk 2>/dev/null \
    || echo "blastbox-fc-guest: ERROR chown /mnt/outdisk to $DROP_USER failed; agent cannot write output" > /dev/console 2>&1

# Bring up loopback. FC guests boot with lo DOWN; warm-UNO's unoserver binds
# soffice on 127.0.0.1 (and unoconvert connects there), so without this the UNO
# socket is unreachable ("couldn't connect to socket") and LibreOffice never
# starts. The cold --convert-to path uses no socket, hence this was never needed.
ip link set lo up 2>/dev/null || ifconfig lo up 2>/dev/null || true

echo "blastbox-fc-guest: init up, dropping to $DROP_USER" > /dev/console 2>/dev/null

# Drop privileges and exec the agent. stdout/stderr (opened here as root) are
# inherited by the unprivileged process and go to the serial console (fc.log).
exec setpriv --reuid "$DROP_USER" --regid "$DROP_USER" --clear-groups \
    python3 /opt/blastbox/run_guest.py > /dev/console 2>&1
# exec only returns if it FAILED — surface it loudly instead of letting PID 1 die into a
# silent kernel panic / hung VM, so the host's fc.log shows the cause.
echo "blastbox-fc-guest: FATAL setpriv/exec of run_guest.py failed (rc=$?)" > /dev/console 2>&1
exit 1
