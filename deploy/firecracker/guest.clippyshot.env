# Sourced by /init for the clippyshot FC rootfs. Selects the non-root user the
# base image set up + the in-VM ClippyShot sandbox mode.
DROP_USER=clippy
GUEST_HOME=/tmp

# The microVM IS the isolation boundary, so ClippyShot runs soffice DIRECTLY via
# its container backend (no nested nsjail/bwrap). WARN_ON_INSECURE accepts the
# container backend's in-process checks under a non-runsc runtime.
export CLIPPYSHOT_SANDBOX=container
export CLIPPYSHOT_WARN_ON_INSECURE=1
export TMPDIR=/tmp

# Warm-UNO: start a persistent soffice UNO server in the engine's warmup() (or
# adopt one the snapshot baked in) so the ~750 ms soffice boot is paid once, not
# per job. The warm conversion is byte/pixel-identical to cold (2026-05-31 spike);
# on any warm failure the engine falls back to the cold --convert-to path. Inert
# unless the image carries the warm engine code (clippyshot uno.py + warmup()).
export CLIPPYSHOT_WARM_UNO=1
