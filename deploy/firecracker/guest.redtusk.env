# Sourced by /init for the redtusk FC rootfs. Selects the non-root user the base
# image set up (redtusk, uid 10001) + the guest scratch home.
DROP_USER=redtusk
GUEST_HOME=/tmp
export TMPDIR=/tmp

# The in-VM engine Popens `java -jar /app/redtusk-worker.jar … --run <scratch>`.
# The engine's defaults already point at /app (where the jar + AOT live in the
# rootfs); these are re-declared because `docker export` drops Docker ENV, and to
# make the in-guest worker config auditable.
export REDTUSK_WORKER_JAR=/app/redtusk-worker.jar
export REDTUSK_AOT_CACHE=/app/redtusk.aot
export REDTUSK_JAVA_LIBRARY_PATH=/app

# Warm/snapshot tier: the HOST reaps idle slots, so the guest must NOT self-retire
# while it sits warm (snapshotted) waiting for a job — and a snapshot-restored
# guest's clock can skew, which would make a short self-timeout fire early. 24h idle
# (run_guest.py's cold-tier default is 120s).
export BLASTBOX_WARM_IDLE_TIMEOUT_S=86400
