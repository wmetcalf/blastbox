# RedTusk engine profile for a NETWORK-ENDPOINT deployment (static / aws-ec2 / aws-lambda-microvm /
# cascade). Source this, then add your chosen tier's knobs (BLASTBOX_POOL_RUNTIME + tier config) — see
# deploy/remote/README.md and docs/CONFIGURATION.md. This slice is the engine-specific config ONLY.
#
# RedTusk runs the Tika-fork against untrusted office/doc/shortcut/calendar files -> a recursive rmeta
# tree (per-entry metadata, extracted text, hashes, thumbnails, QR/OCR, ExploitClass findings).
# Worker image (prebaked, NOT set here): redtusk-cold-worker  (JDK 25 + /app/redtusk-worker.jar + AOT)
# The image bakes BLASTBOX_ENGINE=redtusk.engine:RedTuskEngine.

# --- engine registration (image must already contain the engine + JVM) -----------------------------
export BLASTBOX_ENGINES=redtusk=redtusk-cold-worker:latest

# --- per-job param policy (default-DENY allowlist; lowercase/unlisted keys are dropped) -------------
# Client-forwardable scanner/limit toggles. Add only what you want clients to control.
export BLASTBOX_ENGINE_REDTUSK_PARAM_KEYS=REDTUSK_ENABLE_QR,REDTUSK_ENABLE_OCR,REDTUSK_ENABLE_THUMBNAILS,REDTUSK_MAX_RECURSION_DEPTH,REDTUSK_MAX_EMBEDDED_ENTRIES,REDTUSK_MAX_EXTRACTED_BYTES

# Reserved (dropped UNCONDITIONALLY): the JVM RCE-vector floor — java binary, worker jar, JVM opts,
# native library path, AOT cache, CRaC checkpoint/scratch. A client must never set these.
export BLASTBOX_ENGINE_REDTUSK_RESERVED_KEYS=REDTUSK_JAVA_BIN,REDTUSK_WORKER_JAR,REDTUSK_JAVA_OPTS,REDTUSK_JAVA_LIBRARY_PATH,REDTUSK_AOT_CACHE,REDTUSK_CRAC_CHECKPOINT,REDTUSK_CRAC_SCRATCH

# Operator DEFAULT params. RedTusk QR defaults ON for forensic IOC coverage (warm tiers can't take a
# per-job toggle — the snapshot env is frozen — so default-on guarantees parity). OCR stays opt-in.
export BLASTBOX_ENGINE_REDTUSK_DEFAULT_PARAMS=REDTUSK_ENABLE_QR=1,REDTUSK_ENABLE_OCR=0

# --- egress personality ----------------------------------------------------------------------------
# Tika extraction is pure-local (records links/entities, never resolves; XXE/SSRF structurally absent).
export BLASTBOX_ENGINE_REDTUSK_NETPOLICY=none

# --- resource caps (JVM + recursive extraction wants more than ClippyShot) --------------------------
export BLASTBOX_WORKER_TIMEOUT_S=300
export BLASTBOX_WORKER_MEMORY=2g
export BLASTBOX_WORKER_CPUS=2
export BLASTBOX_WORKER_PIDS_LIMIT=512
# CRITICAL: RedTusk inlines per-entry extracted text, so rmeta can reach ~16 MiB. The 4 MiB metadata
# default rejects ~2.6% of the corpus — raise to 100 MiB. This is a DUAL cap: the host trust-gate +
# extractor enforce it here on the dispatcher, AND the network-endpoint dispatcher forwards it (with the
# artifact/file caps) to the http_agent, which rejects an over-cap result with HTTP 500 before returning
# the tar — so setting it here alone is sufficient; no need to also bake it into the worker image.
export BLASTBOX_MAX_METADATA=104857600

# --- in-worker engine env (baked into the image; re-declared for auditability) ---------------------
# Defaults already point at /app in the image; shown here so the worker config is auditable.
export REDTUSK_WORKER_JAR=/app/redtusk-worker.jar
export REDTUSK_AOT_CACHE=/app/redtusk.aot
export REDTUSK_JAVA_LIBRARY_PATH=/app
