# ClippyShot engine profile for a NETWORK-ENDPOINT deployment (static / aws-ec2 / aws-lambda-microvm /
# cascade). Source this, then add your chosen tier's knobs (BLASTBOX_POOL_RUNTIME + tier config) — see
# deploy/remote/README.md and docs/CONFIGURATION.md. This slice is the engine-specific config ONLY;
# the host/tier config is engine-agnostic.
#
# ClippyShot rasterizes untrusted Office/OpenDocument/text files -> per-page PNGs + metadata.json.
# Worker image (prebaked, NOT set here): clippyshot-cold-worker  (LibreOffice 25.8 + PDFium via pypdfium2)
# The image bakes BLASTBOX_ENGINE=clippyshot.engine:ClippyShotEngine.

# --- engine registration (image must already contain the engine) -----------------------------------
# For the network-endpoint path the worker image is prebaked; this maps the engine NAME the dispatcher
# claims to the image tag it expects. (On aws-ec2 the AMI runs the agent; the tag here is informational
# for a single-engine remote pool, which serves exactly one image.)
export BLASTBOX_ENGINES=clippyshot=clippyshot-cold-worker:latest

# --- per-job param policy (default-DENY allowlist; lowercase/unlisted keys are dropped) -------------
# Client-forwardable scanner toggles: OCR + QR + their tunables.
export BLASTBOX_ENGINE_CLIPPYSHOT_PARAM_KEYS=CLIPPYSHOT_OCR,CLIPPYSHOT_OCR_ALL,CLIPPYSHOT_QR,CLIPPYSHOT_OCR_LANG,CLIPPYSHOT_OCR_PSM,CLIPPYSHOT_QR_FORMATS,CLIPPYSHOT_QR_TIMEOUT_S,CLIPPYSHOT_OCR_TIMEOUT_S

# Reserved (dropped UNCONDITIONALLY even if a client sends them): posture/exec-vector keys — the inner
# sandbox selector, the security-disclosure switch, warm-diag, the OCR engine selector.
export BLASTBOX_ENGINE_CLIPPYSHOT_RESERVED_KEYS=CLIPPYSHOT_WARM_DIAG_FILE,CLIPPYSHOT_SANDBOX,CLIPPYSHOT_WARN_ON_INSECURE,CLIPPYSHOT_DISCLOSE_SECURITY_INTERNALS,CLIPPYSHOT_WARM_OCR,CLIPPYSHOT_OCR_ENGINE

# Operator DEFAULT params (applied when a job doesn't set them; job value always wins). Flip these to
# enable OCR/QR by default without rebuilding the image. Empty = engine defaults (OCR/QR image-gated).
export BLASTBOX_ENGINE_CLIPPYSHOT_DEFAULT_PARAMS=

# --- egress personality ----------------------------------------------------------------------------
# Rendering is pure-local; no network. (The dispatcher forwards BLASTBOX_NET_EGRESS=0 to the worker.)
export BLASTBOX_ENGINE_CLIPPYSHOT_NETPOLICY=none

# --- resource caps (ClippyShot is lighter than a JVM engine) ---------------------------------------
export BLASTBOX_WORKER_TIMEOUT_S=300
export BLASTBOX_WORKER_MEMORY=3g
export BLASTBOX_WORKER_CPUS=2
export BLASTBOX_WORKER_PIDS_LIMIT=256
# metadata.json is small (per-page hashes/QR/OCR text) — the 4 MiB default is fine.

# --- in-worker engine env (baked into the image; re-declared here for auditability) ----------------
# The box/VM IS the isolation boundary on the remote tier, so ClippyShot runs soffice via its
# container backend (no nested nsjail/bwrap). Run the box's own image under runsc for the real boundary.
export CLIPPYSHOT_SANDBOX=container
export CLIPPYSHOT_WARN_ON_INSECURE=1
