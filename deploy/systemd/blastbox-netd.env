# EnvironmentFile for blastbox-netd.service — copy to /etc/blastbox/netd.env and edit.
# Every value is OFF/empty by default (the whole egress overlay is inert until configured).
# See docs/CONFIGURATION.md → "Network policy / egress overlay" for the full reference.

# Per-job root; pcaps land under <job_root>/<job_id>/capture/ — MUST match the dispatcher's.
BLASTBOX_JOB_ROOT=/var/lib/blastbox/jobs

# socks tier: SOCKS5 proxy URL. Empty = disabled.
BLASTBOX_NETD_SOCKS_PROXY=

# vpn tier: VPN+NAT gateway sidecar IP. Empty = disabled.
BLASTBOX_NETD_VPN_GATEWAY=

# inspect tier: sslproxy/MITM gateway IP + its SSLKEYLOGFILE path (for TLS decrypt). Empty = disabled.
BLASTBOX_NETD_INSPECT_GATEWAY=
BLASTBOX_NETD_INSPECT_KEYLOG=

# tor/transproxy tier: host bridge gateway IP + the tor Trans/DNS ports. Empty gateway = disabled.
BLASTBOX_NETD_TRANSPROXY_GATEWAY=
BLASTBOX_NETD_TRANSPROXY_TRANS_PORT=9040
BLASTBOX_NETD_TRANSPROXY_DNS_PORT=5353
